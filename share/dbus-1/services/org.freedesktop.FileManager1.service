# Both dolphin and nautilus ship a .service file claiming this same bus name
# (org.kde.dolphin.FileManager1.service and org.freedesktop.FileManager1.service
# under /usr/share/dbus-1/services). Which one wins the activation is not
# defined, and nautilus cannot simply be removed — it is a hard dependency of
# xdg-desktop-portal-gnome, which serves ScreenCast under niri.
#
# ~/.local/share/dbus-1/services takes precedence over /usr/share, so this file
# settles it. D-Bus activation cannot read mimeapps.list — it matches a bus name
# to a .service file and stops there — so rather than naming a file manager
# here, it activates a script that looks the default up and exec's it. One
# source of truth: change the inode/directory default and "Show in file manager"
# from GTK apps, Chrome and Telegram follows it on the next activation.
[D-BUS Service]
Name=org.freedesktop.FileManager1
Exec=/home/ivanc/.local/bin/filemanager1-dispatch
