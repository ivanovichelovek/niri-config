[Desktop Entry]
Type=Application
Name=Random Wallpaper
Comment=Download a random wallpaper and keep it or throw it away
Exec=/usr/bin/random-wallpaper
Icon=dev.ivanc.RandomWallpaper
Terminal=false
Categories=Graphics;Utility;
StartupWMClass=dev.ivanc.RandomWallpaper
Keywords=wallpaper;background;random;konachan;wallhaven;season;holiday;
Actions=Konachan;Wallhaven;Seasonal;

# --theme all alongside the source, so the label stays true: with a theme the
# source cannot serve, the app borrows the other one, and "From Konachan"
# would quietly be showing Wallhaven.
[Desktop Action Konachan]
Name=From Konachan
Exec=/usr/bin/random-wallpaper --source konachan --theme all

[Desktop Action Wallhaven]
Name=From Wallhaven
Exec=/usr/bin/random-wallpaper --source wallhaven --theme all

# The nine themes live in the Filters dropdown, not here — a launcher menu of
# nine near-identical entries is worse than one that opens the window.
[Desktop Action Seasonal]
Name=Browse what the calendar calls for now
Exec=/usr/bin/random-wallpaper --theme now
