// ─────────────────────────────────────────────────────────────────────────────
// 90 — Your personal overrides
// ─────────────────────────────────────────────────────────────────────────────
//
// This file is YOURS — personal overrides, kept across shell changes.
// Put any custom configuration here: extra binds, per-app window rules,
// output configuration, named workspaces, etc.
//
// Since Niri evaluates config top-to-bottom, settings here take effect
// after all other config.d files. For window-rule properties, all matching
// rules accumulate. For scalar values (like gaps), the last one wins.
//
// Examples:
//
// Named workspaces (sticky, always present)
workspace "term"
workspace "web"
workspace "chat"
workspace "code"
workspace "music"
workspace "vpn"
//
// Per-app workspace assignment

// terminal (kitty)
window-rule {
    match app-id="kitty"
    open-on-workspace "term"
}

// browser (zen) — regex covers both "zen" and "zen-browser" app-ids,
// since the AUR build and the manual /opt install differ.
window-rule {
    match app-id=r#"^zen(-browser)?$"#
    open-on-workspace "web"
    open-maximized true
}

// second browser (google chrome)
window-rule {
    match app-id=r#"^google-chrome$"#
    open-on-workspace "web"
    open-maximized true
}

// chat (telegram) — official client; app-id from org.telegram.desktop.desktop
window-rule {
    match app-id="org.telegram.desktop"
    open-on-workspace "chat"
    open-maximized true
}

// nvim opens kitty with --class nvim, so app-id is "nvim"
window-rule {
    match app-id="nvim"
    open-on-workspace "code"
    open-maximized true
}

// music (yandex)
window-rule {
    match app-id="YandexMusic"
    open-on-workspace "music"
    open-maximized true
}

// vpn (happ) — app-id read off a running window with `niri msg windows`.
// Capital H, exactly "Happ"; happ-desktop-bin ships no .desktop file to check.
window-rule {
    match app-id="Happ"
    open-on-workspace "vpn"
    open-maximized true
}

// VirtualBox: open manager and VM windows maximized.
// Matches both "VirtualBox Manager" and "VirtualBox Machine".
window-rule {
    match app-id=r#"^VirtualBox "#
    open-maximized true
}


binds {
    // ═══════════════════════════════════════════════════════════════════════
    // Tools
    // ═══════════════════════════════════════════════════════════════════════
    //
    // Dropped with the move off the old dotfiles: Mod+N / Mod+Ctrl+N /
    // Mod+Ctrl+D drove ~/.local/share/todoist-remind, which is not carried
    // over. Those three keys are free.

    // Focus mode: remove gaps, corner radius and hide the shell bar.
    Mod+Shift+F repeat=false hotkey-overlay-title="Focus mode" { spawn "/home/ivanc/.local/bin/niri-toggle-gaps"; }

    // Flip the focused output 180° (and back) — open the lid flat and let
    // someone across the table read the screen the right way up.
    Mod+Ctrl+Shift+Alt+F repeat=false hotkey-overlay-title="Flip screen 180°" { spawn "/home/ivanc/.local/bin/niri-flip-screen"; }

    // Download a random wallpaper and preview it before keeping it.
    // Saves to ~/random_wallpaper only when you press Save; Delete throws the
    // download away. Also in the launcher as "Random Wallpaper".
    Ctrl+Alt+W repeat=false hotkey-overlay-title="Random wallpaper" { spawn "/usr/bin/random-wallpaper"; }
}

// The random wallpaper previewer is a dialog, not a workspace app.
window-rule {
    match app-id="dev.ivanc.RandomWallpaper"
    open-floating true
}

//   window-rule {
//       match app-id="firefox"
//       open-on-workspace "browser"
//   }
//
//   // Extra keybind
//   binds {
//       Mod+P { spawn "rofi" "-show" "drun"; }
//   }
//
//   // Output config for your specific monitor
//   output "DP-1" {
//       mode "3440x1440@100.000"
//       scale 1
//       position x=0 y=0
//   }
// ─────────────────────────────────────────────────────────────────────────────

output "eDP-1" {
    position x=0 y=0
}

output "DP-1" {
    position x=1920 y=0
}

output "HDMI-A-1" {
    position x=4480 y=0
}
