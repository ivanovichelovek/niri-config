{
    "dns": {
        "servers": [
            {
                "address": "8.8.8.8",
                "detour": "direct",
                "strategy": "ipv4_only",
                "tag": "dns-proxy"
            }
        ]
    },
    "inbounds": [
        {
            "address": [
                "172.18.0.1/30"
            ],
            "auto_route": true,
            "mtu": 1500,
            "stack": "mixed",
            "strict_route": true,
            "tag": "tun-in",
            "type": "tun"
        }
    ],
    "log": {
        "level": "info",
        "timestamp": true
    },
    "outbounds": [
        {
            "domain_resolver": {
                "server": "dns-proxy",
                "strategy": "prefer_ipv4"
            },
            "server": "127.0.0.1",
            "server_port": 10808,
            "tag": "proxy",
            "type": "socks",
            "udp_fragment": true
        },
        {
            "domain_resolver": {
                "server": "dns-proxy",
                "strategy": "prefer_ipv4"
            },
            "tag": "direct",
            "type": "direct"
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "final": "proxy",
        "rules": [
            {
                "outbound": "direct",
                "process_name": [
                    "xray.exe",
                    "sing-box.exe",
                    "antifilter.exe",
                    "xray",
                    "sing-box",
                    "antifilter"
                ]
            },
            {
                "outbound": "direct",
                "process_path": [
                    "/opt/google/chrome/chrome",
                    "/opt/yandex-music/yandexmusic"
                ]
            },
            {
                "action": "sniff"
            },
            {
                "action": "hijack-dns",
                "protocol": "dns"
            }
        ]
    }
}

