# Copy this to ~/.config/fish/conf.d/secrets.fish and fill in real values.
#
# That path is gitignored — the file must never be committed. If a key ever
# lands in a tracked file, rotate it: removing it in a later commit does not
# remove it from history.

# set -gx ANTHROPIC_API_KEY  sk-ant-...
# set -gx OPENAI_API_KEY     sk-...
# set -gx GITHUB_TOKEN       ghp_...
