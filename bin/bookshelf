                self._enrich_one(book)
                done += 1
                if done % 10 == 0:
                    GLib.idle_add(self.save_and_refresh)

            fresh = 0
            for book in stale:
                GLib.idle_add(self.busy, book.get("title", "")[:40], done, total)
                if refresh_cover(book):
                    fresh += 1
                book["checked_at"] = time.strftime("%Y-%m-%d %H:%M")
                done += 1
            GLib.idle_add(self._log, "Обновление закончено, обложек обновилось: %d" % fresh)
            GLib.idle_add(self.save_and_refresh)
            GLib.idle_add(self.busy)

        threading.Thread(target=work, daemon=True).start()
        return False

    def _enrich_shelf(self, only_untried=False):
        pending = self.enrich_pending(only_untried)
        if not pending:
            if not only_untried:
                self._log("Все книги на полке уже подтверждены.")
            return
        self._log("Обновляю информацию: %d книг…" % len(pending))
        self.busy("ищу данные о книгах", 0, len(pending))
        self.enrich_btn.set_sensitive(False)

        def work():
            done = 0
            for book in pending:
                GLib.idle_add(self.busy, book.get("title", "")[:40], done, len(pending))
                self._enrich_one(book)
                note = "найдено" if book.get("verified") else "нет в каталогах"
                if book.get("verified") and not book.get("cover_url"):
                    note = "карточка есть, обложки нет ни в одном каталоге"
                done += 1
                GLib.idle_add(self._log, "  %s — %s" % (book.get("title", ""), note))
                if done % 20 == 0:
                    GLib.idle_add(self.save_and_refresh)
            GLib.idle_add(self.save_and_refresh)
            GLib.idle_add(self.busy)
            GLib.idle_add(self.enrich_btn.set_sensitive, True)

        threading.Thread(target=work, daemon=True).start()

    # generation -------------------------------------------------------------

    def busy(self, text="", done=0, total=0):
        """Show progress in the top bar. No text ends the run and hides the bar."""
        self.progress_text.set_text(("%d/%d · %s" % (done, total, text)) if total else text)
        self.progress.set_visible(bool(text))
        if total:
            self.progress.set_fraction(min(1.0, done / total))
        elif text:
            self.progress.pulse()
        return False

    def _log(self, text):
        stamp = time.strftime("%H:%M:%S")
        self.log.set_text((self.log.get_text() + "\n%s  %s" % (stamp, text)).strip())

    def _cancel_run(self):
        if self.run_job:
            self.run_job.cancel()
            self._log("Отменяю…")

    def _start_run(self):
        if self.run_job:
            return
        buf = self.ask.get_buffer()
        ask = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
        count = int(["3", "5", "8", "12"][self.count.get_selected()])
        model = MODELS[self.model.get_selected()][1]
        web = self.web.get_active()

        self.config["last_ask"] = ask
        self._save_config()

        prompt = build_prompt(self.profile, ask, count)
        self.run_job = ClaudeRun(prompt, model, web)
        self.go_btn.set_sensitive(False)
        self.cancel_btn.set_sensitive(True)
        self._log("Спрашиваю Claude (%s%s), это занимает от минуты…"
                  % (model, ", со сверкой в интернете" if web else ""))
        self.busy("Claude подбирает книги")
        GLib.timeout_add(700, lambda: self.run_job is not None and (self.progress.pulse() or True))

        def work():
            books, error = self.run_job.run()
            if error:
                GLib.idle_add(self._finish_run, [], error)
                return
            GLib.idle_add(self._log, "Пришло названий: %d. Проверяю по каталогам…" % len(books))
            resolved = []
            for number, item in enumerate(books):
                GLib.idle_add(self.busy, item["title"][:40], number, len(books))
                if self.run_job.cancelled:
                    break
                if self.profile.knows(item["title"], item["author"]):
                    GLib.idle_add(self._log, "  %s — уже на полке, пропускаю" % item["title"])
                    continue
                facts = resolve(item["title"], item["author"], item["lang"],
                                self.profile.data.get("google_books_key", ""))
                book = dict(item)
                book.update(catalogued(item, facts))
                resolved.append(book)
                GLib.idle_add(self._log, "  %s — %s" % (
                    item["title"],
                    "%s, оценка %s" % (facts["source"], facts.get("public_rating") or "—")
                    if facts["verified"] else "НЕ НАЙДЕНО в каталогах, помечаю как непроверенное"))
                book["id"] = uuid.uuid4().hex[:12]
                cover_path(book)
            GLib.idle_add(self._finish_run, resolved, "")

        threading.Thread(target=work, daemon=True).start()

    def _finish_run(self, books, error):
        job, self.run_job = self.run_job, None
        self.busy()
        self.go_btn.set_sensitive(True)
        self.cancel_btn.set_sensitive(False)

        if error:
            self._log("Ошибка: " + error)
            return
        if job and job.cancelled:
            self._log("Отменено.")
            return

        for book in books:
            saved = self.profile.add(book)
            threading.Thread(target=cover_path, args=(saved,), daemon=True).start()
        buf = self.ask.get_buffer()
        self.profile.data.setdefault("runs", []).append({
            "ts": time.strftime("%Y-%m-%d %H:%M"),
            "ask": buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip(),
            "model": MODELS[self.model.get_selected()][1],
            "count": len(books),
        })
        self.save_and_refresh()
        verified = sum(1 for b in books if b.get("verified"))
        self._log("Готово: %d книг на полке, из них подтверждено %d." % (len(books), verified))
        self.stack.set_visible_child_name("shelf")


class App(Gtk.Application):
    def __init__(self, start_tab="shelf"):
        super().__init__(application_id=APP_ID)
        self.start_tab = start_tab

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        # A user's own gtk.css is loaded at APPLICATION priority; go above it so
        # a ricing setup cannot repaint half of this window.
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        window = Bookshelf(self)
        window.stack.set_visible_child_name(self.start_tab)
        window.present()


if __name__ == "__main__":
    # --discover opens straight on the picker: the desktop file offers it as a
    # right-click action, so "ask for new books" is one gesture from the dock.
    import sys
    App("discover" if "--discover" in sys.argv else "shelf").run(None)
