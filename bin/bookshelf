scrollbar { background: transparent; }
"""


def eyebrow(text):
    label = Gtk.Label(label=text, xalign=0)
    label.add_css_class("eyebrow")
    return label


def badge(text, kind=""):
    label = Gtk.Label(label=text)
    label.add_css_class("badge")
    if kind:
        label.add_css_class("badge-" + kind)
    label.set_valign(Gtk.Align.CENTER)
    return label


def button(label, handler, css=None, tooltip=""):
    btn = Gtk.Button(label=label)
    btn.add_css_class("btn")
    if css:
        btn.add_css_class(css)
    if tooltip:
        btn.set_tooltip_text(tooltip)
    btn.connect("clicked", handler)
    return btn


def scrolled(child, vexpand=True):
    sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
    sw.set_vexpand(vexpand)
    sw.set_child(child)
    return sw


def load_cover_async(book, widget, width=COVER_W, height=COVER_H):
    """Fetch the cover in a worker thread; drop it into `widget` when it lands."""
    def work():
        path = cover_path(book)
        if not path:
            return
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), width, height, True)
        except Exception:
            return
        texture = Gdk.Texture.new_for_pixbuf(pixbuf)
        GLib.idle_add(widget.set_paintable, texture)

    threading.Thread(target=work, daemon=True).start()


class RatingStrip(Gtk.Box):
    """Ten buttons, 1..10. Clicking the current mark clears it."""

    def __init__(self, value, on_change):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=3)
        self.on_change = on_change
        self.value = value
        self.buttons = []
        for n in range(1, 11):
            btn = Gtk.Button(label=str(n))
            btn.add_css_class("rate")
            btn.connect("clicked", self._clicked, n)
            self.append(btn)
            self.buttons.append(btn)
        self._paint()

    def _clicked(self, _btn, n):
        self.value = None if self.value == n else n
        self._paint()
        self.on_change(self.value)

    def _paint(self):
        for n, btn in enumerate(self.buttons, start=1):
            if self.value and n <= self.value:
                btn.add_css_class("on")
            else:
                btn.remove_css_class("on")


# ── the book window ─────────────────────────────────────────────────────────

class BookWindow(Gtk.Window):
    """Cover, annotation, why it was recommended — and your own verdict."""

    def __init__(self, parent, app, book):
        super().__init__(title=book.get("title", "Книга"), transient_for=parent, modal=True)
        self.app = app
        self.book = book
        self.set_default_size(820, 720)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.add_css_class("root")
        self.set_child(root)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        body.set_margin_start(18)
        body.set_margin_end(18)
        body.set_margin_top(18)
        body.set_margin_bottom(12)

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.picture = Gtk.Picture()
        self.picture.set_size_request(190, 280)
        self.picture.add_css_class("cover")
        self.picture.set_content_fit(Gtk.ContentFit.CONTAIN)
        left.append(self.picture)
        load_cover_async(book, self.picture, 190, 280)

        for text, kind in self._badges():
            left.append(badge(text, kind))
        left.append(button("Своя обложка", self._pick_cover,
                           tooltip="Выбрать файл на диске — он станет обложкой этой книги"))
        if book.get("cover_from"):
            note = Gtk.Label(label="обложка: «%s»" % book["cover_from"],
                             xalign=0, wrap=True, max_width_chars=24)
            note.add_css_class("mono")
            left.append(note)
        if book.get("source_url"):
            link = Gtk.LinkButton(uri=book["source_url"],
                                  label="Открыть карточку" if book.get("verified") else "Искать вручную")
            link.add_css_class("btn")
            left.append(link)
        body.append(left)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        right.set_hexpand(True)

        title = Gtk.Label(label=book.get("title", ""), xalign=0, wrap=True)
        title.add_css_class("title")
        right.append(title)
        author = Gtk.Label(label=book.get("author", "") or "автор неизвестен", xalign=0, wrap=True)
        author.add_css_class("subtle")
        right.append(author)

        if book.get("catalog_title"):
            other = Gtk.Label(label="в каталоге: %s" % book["catalog_title"],
                              xalign=0, wrap=True)
            other.add_css_class("mono")
            right.append(other)

        meta = " · ".join(str(x) for x in [book.get("kind") or "", book.get("year") or "",
                                           self._public()] if x)
        if meta:
            line = Gtk.Label(label=meta, xalign=0)
            line.add_css_class("mono")
            right.append(line)

        if book.get("why"):
            right.append(eyebrow("ПОЧЕМУ ТЕБЕ"))
            why = Gtk.Label(label=book["why"], xalign=0, wrap=True)
            why.add_css_class("subtle")
            right.append(why)

        source_note = {"royalroad": "Royal Road", "authortoday": "Author.Today",
                       "googlebooks": "Google Books", "openlibrary": "Open Library",
                       "fantlab": "FantLab"}.get(book.get("annotation_from"),
                                                 book.get("annotation_from"))
        right.append(eyebrow("АННОТАЦИЯ" + (" · %s" % source_note.upper() if source_note else "")))
        if book.get("verified"):
            text = book.get("annotation") or "Аннотации в каталоге нет."
        else:
            text = ("Книга не найдена ни на FantLab, ни в Open Library — считай её "
                    "непроверенной, пока не убедишься сам.")
        annotation = Gtk.Label(label=text, xalign=0, wrap=True, yalign=0)
        annotation.add_css_class("subtle")

        # Blurb and the run of books share one scroller: a Holmes cycle brings
        # seventy-seven rows, and they must not push the rating strip off-window.
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        content.append(annotation)

        # A miss is usually a naming difference: the catalogue files a series
        # under the title of its first volume ("Mage Errant" as "Into the
        # Labyrinth"). Adopting one of those silently would be a rename, so the
        # choice is offered instead — one click, and it is labelled afterwards.
        if book.get("neighbours") and not book.get("cover_url"):
            content.append(eyebrow("ЧТО ЕСТЬ У ЭТОГО АВТОРА В КАТАЛОГЕ"))
            for other in book["neighbours"]:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                label = Gtk.Label(label=other["title"] + (" · %s" % other["year"]
                                                          if other.get("year") else ""),
                                  xalign=0, wrap=True)
                label.add_css_class("subtle")
                label.set_hexpand(True)
                row.append(label)
                if other.get("cover_url"):
                    row.append(button("Взять обложку",
                                      lambda _b, o=other: self._adopt(o),
                                      tooltip="Использовать обложку и аннотацию этой записи"))
                content.append(row)
        self.cycle_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        content.append(self.cycle_box)
        holder = scrolled(content)
        holder.set_vexpand(True)
        # Overlay scrollbars are drawn *over* the content, and the thing they
        # covered here was the column of marks on the right.
        holder.set_overlay_scrolling(False)
        right.append(holder)
        if book.get("fantlab_work_id"):
            self._load_cycle(book["fantlab_work_id"])

        right.append(eyebrow("МОЯ ОЦЕНКА"))
        right.append(RatingStrip(book.get("my_rating"), self._set_rating))

        right.append(eyebrow("ВПЕЧАТЛЕНИЕ"))
        self.impression = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD)
        self.impression.get_buffer().set_text(book.get("impression") or "")
        holder = scrolled(self.impression, vexpand=False)
        holder.set_size_request(-1, 110)
        holder.add_css_class("frame")
        right.append(holder)

        body.append(right)
        root.append(body)

        bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bottom.set_margin_start(18)
        bottom.set_margin_end(18)
        bottom.set_margin_bottom(16)

        bottom.append(Gtk.Label(label="Статус"))
        self.status = Gtk.DropDown.new_from_strings([label for _, label in STATUSES])
        keys = [key for key, _ in STATUSES]
        self.status.set_selected(keys.index(book.get("status", "recommended"))
                                 if book.get("status") in keys else 0)
        self.status.connect("notify::selected", self._set_status)
        bottom.append(self.status)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        bottom.append(spacer)
        bottom.append(button("Удалить с полки", self._delete, "btn-danger"))
        bottom.append(button("Сохранить", self._save, "btn-accent"))
        root.append(bottom)

    def _load_cycle(self, work_id):
        """Fetch the cycle's books off the UI thread and list them when they land."""
        def work():
            books = cycle_books(work_id)
            if books:
                GLib.idle_add(self._show_cycle, books)

        threading.Thread(target=work, daemon=True).start()

    def _show_cycle(self, books):
        mine = {b.get("fantlab_work_id"): b.get("my_rating")
                for b in self.app.profile.books if b.get("my_rating")}

        self.cycle_box.append(eyebrow("КНИГИ ЦИКЛА · %d" % len(books)))
        listing = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        for number, book in enumerate(books, start=1):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

            index = Gtk.Label(label="%2d" % number, xalign=1)
            index.add_css_class("mono")
            row.append(index)

            name = Gtk.Label(label=book["title"], xalign=0, ellipsize=3, max_width_chars=38)
            name.add_css_class("subtle")
            name.set_hexpand(True)
            row.append(name)

            if book.get("year"):
                year = Gtk.Label(label=str(book["year"]))
                year.add_css_class("mono")
                row.append(year)

            if book.get("rating"):
                fl = Gtk.Label(label="%.2f" % book["rating"])
                fl.add_css_class("mono")
                fl.set_tooltip_text("Оценка FantLab, %s голосов" % (book.get("votes") or "?"))
                row.append(fl)

            # Your own mark for that volume — settable right here, because
            # rating a cycle as a whole loses exactly the thing you wanted to
            # remember: which book in the run was the good one.
            row.append(self._mark_button(book, mine.get(book["work_id"])))
            listing.append(row)

        self.cycle_box.append(listing)
        return False

    def _adopt(self, other):
        """Take a neighbouring record's cover — and say whose it is."""
        self.book["cover_url"] = other["cover_url"]
        self.book["cover_from"] = other["title"]
        self.book.pop("cover_etag", None)
        for stale in COVER_DIR.glob(self.book["id"] + ".*"):
            stale.unlink(missing_ok=True)

        def work():
            cover_path(self.book)
            GLib.idle_add(load_cover_async, self.book, self.picture, 190, 280)
            GLib.idle_add(self.app.save_and_refresh)

        threading.Thread(target=work, daemon=True).start()

    def _mark_button(self, child, value):
        """A one-click 1–10 picker for a single volume of the cycle."""
        button = Gtk.MenuButton(label=str(value) if value else "—")
        button.add_css_class("rate")
        if value:
            button.add_css_class("on")
        button.set_valign(Gtk.Align.CENTER)

        popover = Gtk.Popover()
        popover.add_css_class("root")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=3)
        box.set_margin_start(8)
        box.set_margin_end(8)
        box.set_margin_top(8)
        box.set_margin_bottom(8)

        def choose(_b, mark):
            popover.popdown()
            self._rate_child(child, mark)
            button.set_label(str(mark) if mark else "—")
            if mark:
                button.add_css_class("on")
            else:
                button.remove_css_class("on")

        clear = Gtk.Button(label="—")
        clear.add_css_class("rate")
        clear.connect("clicked", choose, None)
        box.append(clear)
        for mark in range(1, 11):
            pick = Gtk.Button(label=str(mark))
            pick.add_css_class("rate")
            pick.connect("clicked", choose, mark)
            box.append(pick)
        popover.set_child(box)
        button.set_popover(popover)
        return button

    def _rate_child(self, child, mark):
        """Store a mark for one book of the cycle, adding it to the shelf if it
        is not there yet — the cycle's own entry is a different book."""
        existing = None
        for book in self.app.profile.books:
            if book.get("fantlab_work_id") == child["work_id"]:
                existing = book
                break
        if existing is None:
            if mark is None:
                return
            existing = self.app.profile.add({
                "title": child["title"],
                "author": self.book.get("author", ""),
                "lang": self.book.get("lang", "ru"),
                "why": "Оценка поставлена в карточке цикла «%s»" % self.book.get("title", ""),
                "status": "read",
                "verified": True,
                "source": "fantlab",
                "source_url": "https://fantlab.ru/work%s" % child["work_id"],
                "fantlab_work_id": child["work_id"],
                "kind": child.get("kind", ""),
                "year": child.get("year"),
                "annotation": "",
                "public_rating": child.get("rating"),
                "public_votes": child.get("votes"),
                "cover_url": "",
            })
        existing["my_rating"] = mark
        existing["rated"] = time.strftime("%Y-%m-%d")
        if mark and existing.get("status") == "recommended":
            existing["status"] = "read"
        self.app.save_and_refresh()

    def _pick_cover(self, _btn):
        chooser = Gtk.FileChooserNative(title="Обложка для «%s»" % self.book.get("title", ""),
                                        transient_for=self, action=Gtk.FileChooserAction.OPEN)
        images = Gtk.FileFilter()
        images.set_name("Изображения")
        for pattern in ("*.jpg", "*.jpeg", "*.png", "*.webp"):
            images.add_pattern(pattern)
        chooser.add_filter(images)

        def chosen(dialog, response):
            path = dialog.get_file().get_path() if response == Gtk.ResponseType.ACCEPT \
                and dialog.get_file() else None
            dialog.destroy()
            if not path:
                return
            # Copied, not linked: the picture has to survive the original being
            # moved. Marked manual so the shape check never overrules the choice.
            COVER_DIR.mkdir(parents=True, exist_ok=True)
            suffix = Path(path).suffix.lower() or ".jpg"
            for stale in COVER_DIR.glob(self.book["id"] + ".*"):
                stale.unlink(missing_ok=True)
            target = COVER_DIR / (self.book["id"] + (".png" if suffix == ".png" else ".jpg"))
            shutil.copyfile(path, target)
            self.book["cover_manual"] = True
            self.book["cover_url"] = "file://" + urllib.parse.quote(str(target))
            self.book.pop("cover_from", None)
            self.app.save_and_refresh()
            load_cover_async(self.book, self.picture, 190, 280)

        chooser.connect("response", chosen)
        chooser.show()
        self._chooser = chooser                      # keep it alive until it answers

    def _badges(self):
        out = []
        if self.book.get("verified"):
            out.append(("FANTLAB" if self.book.get("source") == "fantlab" else "OPEN LIBRARY", ""))
        else:
            out.append(("НЕ ПОДТВЕРЖДЕНО", "warn"))
        if self.book.get("my_rating"):
            out.append(("МОЯ %d/10" % self.book["my_rating"], "mine"))
        return out

    def _public(self):
        rating, votes = self.book.get("public_rating"), self.book.get("public_votes")
        if not rating:
            return ""
        scale = "10" if self.book.get("source") == "fantlab" else "5"
        return "%.2f из %s (%s оценок)" % (float(rating), scale, votes or "?")

    def _set_rating(self, value):
        self.book["my_rating"] = value
        if value and self.book.get("status") == "recommended":
            self.book["status"] = "read"
            self.status.set_selected([k for k, _ in STATUSES].index("read"))
        # Persist at once: closing the window with X should not lose the mark.
        self.book["rated"] = time.strftime("%Y-%m-%d")
        self.app.save_and_refresh()

    def _set_status(self, dropdown, _param):
        self.book["status"] = STATUSES[dropdown.get_selected()][0]

    def _read_impression(self):
        buf = self.impression.get_buffer()
        return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()

    def _save(self, _btn):
        self.book["impression"] = self._read_impression()
        if self.book.get("my_rating") or self.book["impression"]:
            self.book["rated"] = time.strftime("%Y-%m-%d")
        self.app.save_and_refresh()
        self.close()

    def _delete(self, _btn):
        self.app.profile.books.remove(self.book)
        self.app.save_and_refresh()
        self.close()


class BookCard(Gtk.Button):
    def __init__(self, app, book, parent_window):
        super().__init__()
        self.add_css_class("book")
        if book.get("my_rating"):
            self.add_css_class("mine")
        self.set_size_request(COVER_W + 20, -1)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        frame = Gtk.Box()
        frame.set_size_request(COVER_W, COVER_H)
        frame.set_overflow(Gtk.Overflow.HIDDEN)      # COVER fit spills otherwise
        frame.add_css_class("cover")
        picture = Gtk.Picture()
        picture.set_content_fit(Gtk.ContentFit.COVER)
        picture.set_hexpand(True)
        picture.set_vexpand(True)
        frame.append(picture)
        box.append(frame)
        load_cover_async(book, picture)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        body.add_css_class("book-body")

        title = Gtk.Label(label=book.get("title", ""), xalign=0, wrap=True, lines=2,
                          ellipsize=3, max_width_chars=18)
        title.add_css_class("book-title")
        body.append(title)

        author = Gtk.Label(label=book.get("author", ""), xalign=0, ellipsize=3, max_width_chars=18)
        author.add_css_class("book-author")
        body.append(author)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        if book.get("my_rating"):
            row.append(badge("%d/10" % book["my_rating"], "mine"))
        if not book.get("verified"):
            row.append(badge("?", "warn"))
        elif book.get("public_rating"):
            row.append(badge("%s %.1f" % ("FL" if book.get("source") == "fantlab" else "OL",
                                          float(book["public_rating"]))))
        if book.get("kind"):
            row.append(badge(book["kind"].upper()))
        body.append(row)

        box.append(body)
        self.set_child(box)
        self.connect("clicked", lambda _b: BookWindow(parent_window, app, book).present())


class BookGrid(Gtk.FlowBox):
    def __init__(self):
        super().__init__(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                         column_spacing=12, row_spacing=12, max_children_per_line=8,
                         min_children_per_line=2, valign=Gtk.Align.START)
        self.set_margin_start(16)
        self.set_margin_end(16)
        self.set_margin_top(16)
        self.set_margin_bottom(16)

    def fill(self, app, books, window, empty_text):
        while (child := self.get_first_child()) is not None:
            self.remove(child)
        if not books:
            label = Gtk.Label(label=empty_text)
            label.add_css_class("placeholder")
            self.append(label)
            return
        for book in books:
            self.append(BookCard(app, book, window))


# ── the application ─────────────────────────────────────────────────────────

class Bookshelf(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Bookshelf")
        self.set_default_size(1180, 820)
        self.run_job = None

        self.config = self._load_config()
        self.profile = self._pick_profile()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.add_css_class("root")
        self.set_child(root)

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        top.add_css_class("topbar")
        wordmark = Gtk.Label(label="BOOKSHELF")
        wordmark.add_css_class("wordmark")
        top.append(wordmark)
        self.summary = Gtk.Label(label="", xalign=0)
        self.summary.add_css_class("mono")
        top.append(self.summary)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        top.append(spacer)

        # Work happens in threads and the user may be on any tab, so the bar
        # says what is going on where it is always visible.
        self.progress_text = Gtk.Label(label="", xalign=1, ellipsize=3, max_width_chars=52)
        self.progress_text.add_css_class("mono")
        top.append(self.progress_text)
        self.progress = Gtk.ProgressBar()
        self.progress.add_css_class("progress")
        self.progress.set_size_request(130, -1)
        self.progress.set_valign(Gtk.Align.CENTER)
        self.progress.set_visible(False)
        top.append(self.progress)

        self.who = Gtk.Label(label="")
        self.who.add_css_class("mono")
        top.append(self.who)
        root.append(top)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.NONE)
        switcher = Gtk.StackSwitcher(stack=self.stack)
        switcher.add_css_class("tabs")
        root.append(switcher)

        self.stack.add_titled(self._shelf_page(), "shelf", "Полка")
        self.stack.add_titled(self._ratings_page(), "ratings", "Оценки")
        self.stack.add_titled(self._discover_page(), "discover", "Подбор")
        self.stack.add_titled(self._profiles_page(), "profiles", "Профили")
        self.stack.set_vexpand(True)
        self.stack.add_css_class("stage")
        root.append(self.stack)

        self.load_profile_fields()
        self.refresh()
        # Every launch catches up: new marks, then whatever never got a card,
        # then a slice of the rest revalidated against the catalogues.
        GLib.timeout_add(600, self._refresh_on_launch)

    # config / profiles ------------------------------------------------------

    def _load_config(self):
        if CONFIG_FILE.exists():
            try:
                return json.loads(CONFIG_FILE.read_text("utf-8"))
            except Exception:
                pass
        return {}

    def _save_config(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(json.dumps(self.config, ensure_ascii=False, indent=2), "utf-8")

    def _pick_profile(self):
        paths = Profile.all()
        if not paths:
            profile = Profile.create("Иван", "208739")
            import_legacy_log(profile)
            return profile
        wanted = self.config.get("profile")
        for path in paths:
            if str(path) == wanted:
                try:
                    return Profile.load(path)
                except Exception:
                    break
        return Profile.load(paths[0])

    def switch_profile(self, path):
        self.profile = Profile.load(path)
        self.config["profile"] = str(path)
        self._save_config()
        self.load_profile_fields()
        self.refresh()

    def load_profile_fields(self):
        """Only when the profile itself changes — refresh() runs on every save,
        and re-filling these would eat whatever the user is typing."""
        self.taste.get_buffer().set_text(self.profile.data.get("taste_note", ""))
        self.fantlab_id.set_text(self.profile.data.get("fantlab_user_id", ""))
        self.google_key.set_text(self.profile.data.get("google_books_key", ""))

    # pages ------------------------------------------------------------------

    def _shelf_page(self):
