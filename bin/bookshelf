#!/usr/bin/env python3
"""Bookshelf — a reading desk for books Claude recommends.

Four tabs instead of one page: the shelf of open recommendations, the record of
what you have read and what you thought of it, the picker that asks Claude for
more, and the profiles that let several people share one desk.

Two rules the rest of the code follows from:

  * Claude proposes only a title, an author and a reason. Everything a card
    shows as fact — cover, annotation, year, public rating — is looked up here,
    against FantLab (ru) and Open Library (en). A title that resolves nowhere
    is drawn as "не подтверждено" instead of quietly passing for a real book,
    because a recommender that invents plausible titles is worse than none.

  * Ratings and impressions live in this house and nowhere else: one JSON file
    per profile under ~/.local/share/bookshelf/profiles/, readable by a human
    or by a future Claude session with a single open(). Nothing is ever sent
    to FantLab or any other site.

Generation shells out to the `claude` CLI, so it draws on the subscription
already installed on this machine — no API key, no separate token budget.
"""
import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")

import json
import os
import re
import shutil
import subprocess
import threading
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
import uuid
from pathlib import Path

from gi.repository import GdkPixbuf, Gdk, GLib, Gtk

APP_ID = "dev.ivanc.Bookshelf"

DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "bookshelf"
PROFILE_DIR = DATA_DIR / "profiles"
COVER_DIR = DATA_DIR / "covers"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "bookshelf"
CONFIG_FILE = CONFIG_DIR / "config.json"

# Seeds for the very first launch, written by earlier Claude sessions.
LEGACY_LOG = Path.home() / "Books/recommendations-log.md"

# FantLab rejects the default urllib agent, the same way Konachan does.
USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"
)
TIMEOUT = 30

COVER_W, COVER_H = 148, 216

# Startup refresh budget. Books that never got a card are retried on every
# launch, but not more often than RETRY_AFTER hours — a title that genuinely
# does not exist anywhere should not cost four requests every time the window
# opens. Books that do have a card are re-checked at most STALE_PER_LAUNCH at a
# time and only once every STALE_AFTER days, so two hundred of them drift
# through over a fortnight instead of arriving as one long stall at startup.
RETRY_AFTER_HOURS = 24
STALE_AFTER_DAYS = 21
STALE_PER_LAUNCH = 25

STATUSES = [
    ("recommended", "В подборке"),
    ("reading", "Читаю"),
    ("read", "Прочитано"),
    ("skipped", "Отложено"),
]

MODELS = [("Sonnet — быстрее", "sonnet"), ("Opus — точнее", "opus"), ("Haiku — дешевле", "haiku")]


# ── plumbing ────────────────────────────────────────────────────────────────

def http_bytes(url, timeout=TIMEOUT, etag="", modified=""):
    """Fetch a URL. With an etag or a date, a server that says "not modified"
    costs one round trip and no body — which is what makes re-checking two
    hundred covers on every launch affordable.

    Returns (data, etag, modified); data is None when nothing changed.
    """
    headers = {"User-Agent": USER_AGENT}
    if etag:
        headers["If-None-Match"] = etag
    if modified:
        headers["If-Modified-Since"] = modified
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read(), resp.headers.get("ETag", ""), resp.headers.get("Last-Modified", "")
    except urllib.error.HTTPError as exc:
        if exc.code == 304:
            return None, etag, modified
        raise


def fetch(url, timeout=TIMEOUT):
    """Just the bytes, for callers with nothing cached to compare against."""
    return http_bytes(url, timeout)[0]


def http_json(url, timeout=TIMEOUT):
    return json.loads(fetch(url, timeout).decode("utf-8", "replace"))


def norm(text):
    # NFC, never NFKD: decomposition splits "ё" and "й" into a letter plus a
    # combining mark, the mark is then stripped as punctuation, and "тёмный"
    # comes out as "те мныи" — two titles that differ only in ё would stop
    # matching each other.
    text = unicodedata.normalize("NFC", (text or "").lower()).replace("ё", "е")
    return re.sub(r"[^0-9a-zа-я ]+", " ", text).strip()


def surname(author):
    """The longest word of a name — good enough to tell one author from another."""
    words = [w for w in norm(author).split() if len(w) > 2]
    return max(words, key=len) if words else ""


def author_matches(wanted, got):
    """Is this the same author? Every word of the shorter name has to appear in
    the other. A surname alone is not enough: "Bierce" fits both John Bierce,
    who wrote Mage Errant, and Ambrose Bierce, who died in 1914."""
    mine = [w for w in norm(wanted).split() if len(w) > 2]
    theirs = [w for w in norm(got).split() if len(w) > 2]
    if not mine or not theirs:
        return True
    short, long = (mine, theirs) if len(mine) <= len(theirs) else (theirs, mine)
    return all(word in long for word in short)


def slugify(name):
    base = re.sub(r"[^0-9a-zA-Zа-яА-Я]+", "-", name).strip("-").lower()
    return base or "profile"


# ── metadata lookup ─────────────────────────────────────────────────────────

def fantlab_lookup(title, author):
    """Resolve a title on FantLab. Returns a dict of facts, or None."""
    url = "https://api.fantlab.ru/search-works?q=" + urllib.parse.quote(title) + "&page=1"
    try:
        matches = http_json(url).get("matches") or []
    except Exception:
        return None

    want_author = surname(author)
    want_title = norm(title)
    scored = []
    for m in matches:
        names = " ".join(str(m.get(k) or "") for k in
                         ("autor_rusname", "all_autor_rusname", "autor1_rusname", "autor2_rusname"))
        if author and not any(author_matches(author, one) for one in names.split("  ") or [names]):
            continue
        got_title = norm(m.get("rusname") or m.get("fullname") or "")
        if not (want_title in got_title or got_title in want_title):
            continue
        # A cycle is the better card when both exist: the user prefers series.
        score = (2 if m.get("work_type_id") == 4 else 1, m.get("markcount") or 0)
        scored.append((score, m))
    if not scored:
        return None
    ranked = [m for _, m in sorted(scored, key=lambda pair: pair[0], reverse=True)]
    best = ranked[0]

    work_id = best.get("work_id")
    try:
        work = http_json("https://api.fantlab.ru/work/%d" % work_id)
    except Exception:
        work = {}

    # A cycle carries the rating but never a cover — FantLab hangs covers off
    # editions, and editions belong to the individual novels. Borrow the first
    # one that has a picture, so the card is not a grey rectangle.
    image = work.get("image") or work.get("image_preview") or ""
    annotation = (work.get("work_description") or "").strip()
    if not image or not annotation:
        for other in ranked[1:4]:
            try:
                sibling = http_json("https://api.fantlab.ru/work/%d" % other["work_id"])
            except Exception:
                continue
            image = image or sibling.get("image") or sibling.get("image_preview") or ""
            annotation = annotation or (sibling.get("work_description") or "").strip()
            if image and annotation:
                break
    return {
        "verified": True,
        "source": "fantlab",
        "source_url": "https://fantlab.ru/work%d" % work_id,
        "fantlab_work_id": work_id,
        "title": work.get("work_name") or best.get("rusname") or title,
        "author": work.get("work_lp") or best.get("autor_rusname") or author,
        # work_type is the Russian word ("цикл"); work_type_name is "cycle".
        "kind": work.get("work_type") or best.get("name_show_im") or "",
        "year": work.get("work_year") or best.get("year") or None,
        "annotation": annotation,
        "public_rating": work.get("val_midmark") or (best.get("midmark") or [None])[0],
        "public_votes": work.get("val_voters") or best.get("markcount"),
        "cover_url": ("https://fantlab.ru" + image) if image.startswith("/") else image,
    }


OL_FIELDS = "title,author_name,cover_i,first_publish_year,key,ratings_average,ratings_count"


def _ol_search(params):
    url = "https://openlibrary.org/search.json?" + urllib.parse.urlencode(params) + \
          "&limit=8&fields=" + OL_FIELDS
    try:
        return http_json(url).get("docs") or []
    except Exception:
        return []


def openlibrary_lookup(title, author):
    # Fielded search first: Open Library's free-text q is strict enough to
    # return nothing at all for "Arcane Ascension Andrew Rowe".
    docs = _ol_search({"title": title, "author": author}) if author else []
    docs = docs or _ol_search({"q": "%s %s" % (title, author)})
    # A fielded query with an apostrophe in it ("Bryce O'Connor") comes back
    # empty even when the book is there, so ask by author alone before giving
    # up. The title still has to match — this widens the net, not the rule.
    docs = docs or (_ol_search({"author": author}) if author else [])
    docs = docs or _ol_search({"title": title})
    if not docs:
        return None

    want_author = surname(author)
    want_title = norm(title)

    def fits(d):
        names = " ".join(d.get("author_name") or [])
        got_title = norm(d.get("title") or "")
        if author and not author_matches(author, names):
            return False
        # The title has to match too. Matching on the author alone quietly
        # renames the recommendation to some other book of theirs, which is a
        # worse failure than admitting the catalogue does not have this one.
        return want_title in got_title or got_title in want_title

    pool = [d for d in docs if fits(d)]
    if not pool:
        return None

    def rank(d):
        got_title = norm(d.get("title") or "")
        # A series name is often not a book title — "Cradle" is a series whose
        # first volume is "Unsouled". Prefer an exact title, then anything that
        # is not openly labelled a later volume, then the earliest printing.
        later_volume = bool(re.search(r"volume|book \d|\d", got_title))
        return (got_title != want_title, later_volume, not d.get("cover_i"),
                d.get("first_publish_year") or 9999, len(got_title))

    ranked = sorted(pool, key=rank)
    best = ranked[0]

    def description(doc):
        key = doc.get("key") or ""
        if not key:
            return ""
        try:
            desc = http_json("https://openlibrary.org%s.json" % key).get("description")
        except Exception:
            return ""
        return ((desc.get("value") if isinstance(desc, dict) else desc) or "").strip()

    # Editions of one book are separate records here, and only some carry the
    # blurb or the cover; take them from whichever sibling has them.
    key = best.get("key") or ""
    annotation = description(best)
    cover = best.get("cover_i")
    spares = []
    for other in ranked[1:4]:
        if other.get("cover_i") and other.get("cover_i") != cover:
            spares.append("https://covers.openlibrary.org/b/id/%d-L.jpg" % other["cover_i"])
        if annotation and cover:
            continue
        cover = cover or other.get("cover_i")
        annotation = annotation or description(other)
    return {
        "verified": True,
        "source": "openlibrary",
        "source_url": "https://openlibrary.org%s" % key,
        "title": best.get("title") or title,
        "author": ", ".join(best.get("author_name") or []) or author,
        "kind": "",
        "year": best.get("first_publish_year"),
        "annotation": annotation.strip(),
        "public_rating": best.get("ratings_average"),
        "public_votes": best.get("ratings_count"),
        "cover_url": ("https://covers.openlibrary.org/b/id/%d-L.jpg" % cover) if cover else "",
        "cover_candidates": spares,
    }


_CYCLE_COVERS = {}


def saga_id(work):
    """The cycle a work belongs to. FantLab returns it as a bare id or a list."""
    for key in ("work_saga", "work_root_saga"):
        value = work.get(key)
        if isinstance(value, list) and value:
            value = value[0].get("work_id") if isinstance(value[0], dict) else value[0]
        if isinstance(value, int) and value:
            return value
    return None


def cycle_cover(cycle_id, author):
    """The cover of the cycle a book sits in.

    A single short story has no edition of its own — forty-six Holmes stories
    share the covers of the collections — and neither does the cycle record.
    So take the cycle's name and look it up the ordinary way, which lands on a
    novel or collection under it that does have a picture. Cached per cycle,
    because the whole point is that many books share one answer.
    """
    if cycle_id in _CYCLE_COVERS:
        return _CYCLE_COVERS[cycle_id]
    result = ("", "")
    try:
        # ?children=1 is what lists the works standing under a cycle; without
        # it the cycle looks childless and there is nothing to borrow from.
        cycle = http_json("https://api.fantlab.ru/work/%d?children=1" % int(cycle_id))
    except Exception:
        cycle = {}
    name = cycle.get("work_name") or ""
    image = cycle.get("image") or cycle.get("image_preview") or ""
    if image:
        result = ("https://fantlab.ru" + image if image.startswith("/") else image, name)
    else:
        # Novels and collections get printed as books and so have covers;
        # single stories almost never do, so try those last.
        children = cycle.get("children") or []
        weight = {"роман": 0, "сборник": 1, "повесть": 2}
        children.sort(key=lambda c: weight.get(c.get("work_type"), 9))
        for child in children[:5]:
            try:
                sub = http_json("https://api.fantlab.ru/work/%d" % child["work_id"])
            except Exception:
                continue
            child_image = sub.get("image") or sub.get("image_preview") or ""
            if child_image:
                result = ("https://fantlab.ru" + child_image
                          if child_image.startswith("/") else child_image, name)
                break
    _CYCLE_COVERS[cycle_id] = result
    return result


_CYCLE_TEXTS = {}


def cycle_annotation(cycle_id):
    """The cycle's own description, or the first one under it that has any."""
    if cycle_id in _CYCLE_TEXTS:
        return _CYCLE_TEXTS[cycle_id]
    result = ("", "")
    try:
        cycle = http_json("https://api.fantlab.ru/work/%d?children=1" % int(cycle_id))
    except Exception:
        cycle = {}
    name = cycle.get("work_name") or ""
    text = (cycle.get("work_description") or "").strip()
    if not text:
        children = cycle.get("children") or []
        weight = {"роман": 0, "сборник": 1, "повесть": 2}
        children.sort(key=lambda c: weight.get(c.get("work_type"), 9))
        for child in children[:4]:
            try:
                sub = http_json("https://api.fantlab.ru/work/%d" % child["work_id"])
            except Exception:
                continue
            text = (sub.get("work_description") or "").strip()
            if text:
                break
    if text:
        result = (text, name)
    _CYCLE_TEXTS[cycle_id] = result
    return result


_CYCLE_BOOKS = {}


def cycle_books(cycle_id):
    """The works standing under a cycle, with their ratings.

    One request carries the whole thing — name, year, average and vote count
    for every book — so a cycle's card can show the run the way FantLab does,
    with the weak volume visible instead of averaged away.
    """
    if cycle_id in _CYCLE_BOOKS:
        return _CYCLE_BOOKS[cycle_id]
    try:
        children = http_json("https://api.fantlab.ru/work/%d?children=1"
                             % int(cycle_id)).get("children") or []
    except Exception:
        children = []
    books = [{
        "work_id": child.get("work_id"),
        "title": child.get("work_name") or "",
        "kind": child.get("work_type") or "",
        "year": child.get("work_year"),
        "rating": float(child["val_midmark"]) if child.get("val_midmark") else None,
        "votes": child.get("val_voters"),
    } for child in children if child.get("work_name")]
    _CYCLE_BOOKS[cycle_id] = books
    return books


def fantlab_fill(work_id, author=""):
    """Fetch what a marks list leaves out: cover, annotation, public rating.

    A cycle has no cover of its own — the editions belong to its novels — so
    fall back to a child work, and past that to the cycle the book belongs to.
    """
    try:
        work = http_json("https://api.fantlab.ru/work/%d" % int(work_id))
    except Exception:
        return {}

    image = work.get("image") or work.get("image_preview") or ""
    annotation = (work.get("work_description") or "").strip()
    if not image:
        for child in (work.get("children") or [])[:6]:
            child_id = child.get("work_id") if isinstance(child, dict) else None
            if not child_id:
                continue
            try:
                sub = http_json("https://api.fantlab.ru/work/%d" % child_id)
            except Exception:
                continue
            image = sub.get("image") or sub.get("image_preview") or ""
            annotation = annotation or (sub.get("work_description") or "").strip()
            if image:
                break

    filled = {
        "annotation": annotation,
        "kind": work.get("work_type") or "",
        "year": work.get("work_year"),
        "public_rating": work.get("val_midmark"),
        "public_votes": work.get("val_voters"),
        "cover_url": ("https://fantlab.ru" + image) if image.startswith("/") else image,
    }
    cycle = saga_id(work)
    if not filled["annotation"] and cycle:
        # A single story rarely carries a blurb of its own; the cycle's says
        # what the reader actually needs to know, as long as it is labelled.
        text, name = cycle_annotation(cycle)
        if text:
            filled["annotation"] = text
            filled["annotation_from"] = "цикл «%s»" % name if name else "цикл"
    if not filled["cover_url"]:
        if cycle:
            url, name = cycle_cover(cycle, author or work.get("work_lp") or "")
            if url:
                filled["cover_url"] = url
                filled["cover_from"] = name
        else:
            # No parent to borrow from — this *is* the cycle. Look under itself.
            url, _ = cycle_cover(int(work_id), author)
            filled["cover_url"] = url
    return filled


def _html(url):
    return fetch(url).decode("utf-8", "replace")


def _meta(page, prop):
    found = re.search(r'<meta property="%s" content="([^"]*)"' % prop, page)
    return html_unescape(found.group(1)) if found else ""


def html_unescape(text):
    import html
    return html.unescape(text or "").strip()


def royalroad_lookup(title, author):
    """Royal Road — where most English progression fantasy is first serialised.

    Its authors write under pen names ("nobody103" is Domagoj Kurmaić), so the
    author cannot be used to confirm a match, and a loose title match happily
    returns somebody else's «Mage Errant». Hence exact titles only.
    """
    try:
        results = _html("https://www.royalroad.com/fictions/search?title=" +
                        urllib.parse.quote(title))
    except Exception:
        return None

    want = norm(title)
    for block in results.split("fiction-list-item")[1:8]:
        link = re.search(r'href="(/fiction/\d+/[^"]+)"', block)
        name = re.search(r'class="[^"]*font-red-sunglo[^"]*"[^>]*>([^<]+)<', block)
        if not link or not name or norm(html_unescape(name.group(1))) != want:
            continue
        try:
            page = _html("https://www.royalroad.com" + link.group(1))
        except Exception:
            return None
        return {
            "verified": True,
            "source": "royalroad",
            "source_url": "https://www.royalroad.com" + link.group(1),
            "title": html_unescape(name.group(1)),
            "author": author,
            "kind": "веб-роман",
            "year": None,
            "annotation": _meta(page, "og:description"),
            "public_rating": None,
            "public_votes": None,
            "cover_url": _meta(page, "og:image"),
        }
    return None


def authortoday_lookup(title, author):
    """Author.Today — where the Russian боярка and ЛитРПГ FantLab misses lives."""
    try:
        results = _html("https://author.today/search?q=" + urllib.parse.quote(title) +
                        "&category=works")
    except Exception:
        return None

    want_title, want_author = norm(title), surname(author)
    for block in results.split('<div class="book-row')[1:8]:
        link = re.search(r'href="(/work/\d+)"', block)
        if not link:
            continue
        names = " ".join(re.findall(r'href="/u/[^"]+"[^>]*>([^<]+)<', block))
        if author and not author_matches(author, names):
            continue
        try:
            page = _html("https://author.today" + link.group(1))
        except Exception:
            continue
        # og:title is "Название - Автор", which is the only place on the page
        # where the author is reliably present — the search rows often omit it.
        got, _, got_author = _meta(page, "og:title").partition(" - ")
        if want_title not in norm(got) and norm(got) not in want_title:
            continue
        if author and got_author and not author_matches(author, got_author):
            continue
        return {
            "verified": True,
            "source": "authortoday",
            "source_url": "https://author.today" + link.group(1),
            "title": got or title,
            "author": author,
            "kind": "",
            "year": None,
            "annotation": _meta(page, "og:description"),
            "public_rating": None,
            "public_votes": None,
            "cover_url": _meta(page, "og:image"),
        }
    return None


def googlebooks_lookup(title, author, key=""):
    """Google Books. Without a key this IP is refused outright, so it is opt-in:
    the key goes in the Профили tab and is only used when it is there."""
    if not key:
        return None
    query = "intitle:%s" % urllib.parse.quote(title)
    if author:
        query += "+inauthor:%s" % urllib.parse.quote(author)
    try:
        items = http_json("https://www.googleapis.com/books/v1/volumes?q=%s&maxResults=5&key=%s"
                          % (query, urllib.parse.quote(key))).get("items") or []
    except Exception:
        return None

    want_title, want_author = norm(title), surname(author)
    for item in items:
        info = item.get("volumeInfo") or {}
        if author and not author_matches(author, " ".join(info.get("authors") or [])):
            continue
        got = norm(info.get("title") or "")
        if want_title not in got and got not in want_title:
            continue
        image = (info.get("imageLinks") or {}).get("thumbnail", "")
        return {
            "verified": True,
            "source": "googlebooks",
            "source_url": info.get("infoLink") or "",
            "title": info.get("title") or title,
            "author": ", ".join(info.get("authors") or []) or author,
            "kind": "",
            "year": (info.get("publishedDate") or "")[:4] or None,
            "annotation": info.get("description") or "",
            "public_rating": info.get("averageRating"),
            "public_votes": info.get("ratingsCount"),
            "cover_url": image.replace("&edge=curl", "").replace("http://", "https://"),
        }
    return None


def openlibrary_neighbours(title, author):
    """What the catalogue does have by this author.

    Open Library files a series under the title of its first volume — "Mage
    Errant" is shelved as "Into the Labyrinth" — so a miss is often a naming
    difference rather than an invented book. We show the neighbours and let the
    reader judge, instead of silently adopting one of them as the answer.
    """
    if not author:
        return []
    docs = _ol_search({"q": "%s %s" % (title, author)}) or _ol_search({"author": author})
    seen, out = set(), []
    for d in docs:
        if not author_matches(author, " ".join(d.get("author_name") or [])):
            continue
        name = d.get("title") or ""
        if not name or name in seen:
            continue
        seen.add(name)
        out.append({"title": name,
                    "year": d.get("first_publish_year"),
                    "key": d.get("key") or "",
                    "cover_url": ("https://covers.openlibrary.org/b/id/%d-L.jpg" % d["cover_i"])
                    if d.get("cover_i") else ""})
    return out[:4]


def resolve(title, author, lang, google_key=""):
    """Identify a book, then keep asking other catalogues for what is missing.

    The first catalogue that confirms the book decides its identity; the ones
    after it only fill the holes — an annotation, another cover to try — and
    each contribution is recorded, so a card can say where its blurb came from.
    """
    catalogues = [fantlab_lookup, openlibrary_lookup]
    if lang == "en":
        catalogues.reverse()
    catalogues += [royalroad_lookup if lang == "en" else authortoday_lookup,
                   lambda t, a: googlebooks_lookup(t, a, google_key)]

    # Titles written by hand often trail an explanation — "Гибрид (1-я книга …)".
    # Catalogues index the bare name, so retry without the parenthesis.
    bare = re.sub(r"\s*[\(\[].*$", "", title).strip()
    variants = [title] + ([bare] if bare and bare != title else [])

    found = None
    for probe in catalogues:
        for variant in variants:
            try:
                hit = probe(variant, author)
            except Exception:
                hit = None
            if not hit:
                continue
            if found is None:
                found = hit
                found["cover_candidates"] = ([hit["cover_url"]] if hit["cover_url"] else []) \
                    + list(hit.get("cover_candidates") or [])
            else:
                if hit.get("cover_url"):
                    found.setdefault("cover_candidates", []).append(hit["cover_url"])
                if hit.get("annotation") and not found.get("annotation"):
                    found["annotation"] = hit["annotation"]
                    found["annotation_from"] = hit["source"]
            break
        if found and found.get("annotation") and len(found.get("cover_candidates") or []) > 1:
            break

    if found:
        return found

    neighbours = openlibrary_neighbours(title, author)
    hint = ("Точного совпадения нет. У этого автора в каталоге: %s."
            % ", ".join(n["title"] for n in neighbours)) if neighbours else ""
    search_url = "https://openlibrary.org/search?" + urllib.parse.urlencode(
        {"q": "%s %s" % (title, author)}) if lang == "en" else \
        "https://fantlab.ru/searchmain?searchstr=" + urllib.parse.quote(title)
    return {"verified": False, "source": "", "source_url": search_url, "title": title,
            "author": author, "kind": "", "year": None, "annotation": "", "public_rating": None,
            "public_votes": None, "cover_url": "", "hint": hint,
            "neighbours": neighbours}


def catalogued(book, facts):
    """Merge a catalogue record into a book without renaming it.

    Catalogues file things under their own wording: "Cradle" is shelved as
    "Unsouled : Cradle", a trilogy as "… Omnibus". Overwriting the title with
    that leaves a shelf full of books the reader never asked for — the name a
    book was recommended under is the one it has to keep. The catalogue's
    wording is kept beside it and shown as a footnote in the book window.
    """
    merged = {k: v for k, v in facts.items() if k not in ("title", "author")}
    for field in ("title", "author"):
        theirs, ours = (facts.get(field) or "").strip(), (book.get(field) or "").strip()
        if theirs and norm(theirs) != norm(ours):
            merged["catalog_" + field] = theirs
        elif theirs and not ours:
            merged[field] = theirs
    return merged


# A printed cover is a tall rectangle. Anything appreciably squarer or wider is
# something else that got filed as a cover — Open Library takes reader photos,
# and a shelfie or a square audiobook tile is worse than no picture at all.
COVER_RATIO = (0.55, 0.80)
COVER_MIN_W, COVER_MIN_H = 110, 160


def usable_cover(data):
    """Is this actually a book cover? Returns the decoded size, or None."""
    if not data or len(data) < 2000:
        return None
    loader = GdkPixbuf.PixbufLoader()
    try:
        loader.write(data)
        loader.close()
        pixbuf = loader.get_pixbuf()
    except Exception:
        try:
            loader.close()
        except Exception:
            pass
        return None
    if pixbuf is None:
        return None
    width, height = pixbuf.get_width(), pixbuf.get_height()
    if width < COVER_MIN_W or height < COVER_MIN_H:
        return None
    if not COVER_RATIO[0] <= width / height <= COVER_RATIO[1]:
        return None
    return width, height


def cover_path(book):
    """Download the cover once; afterwards it is a local file.

    Every candidate the catalogues offered is tried in turn and the first one
    that looks like a cover wins, so one bad photograph does not cost the book
    its picture. A hand-picked cover is never second-guessed.
    """
    candidates = [book.get("cover_url") or ""] + list(book.get("cover_candidates") or [])
    candidates = [u for i, u in enumerate(candidates) if u and u not in candidates[:i]]
    if not candidates:
        return None

    COVER_DIR.mkdir(parents=True, exist_ok=True)
    existing = [COVER_DIR / (book["id"] + ext) for ext in (".jpg", ".png")]
    for target in existing:
        if target.exists() and target.stat().st_size > 0:
            return target

    for url in candidates:
        if url.startswith("file://"):
            return Path(urllib.parse.unquote(url[7:]))
        try:
            data, etag, modified = http_bytes(url)
        except Exception:
            continue
        if not book.get("cover_manual") and not usable_cover(data):
            continue
        target = COVER_DIR / (book["id"] + (".png" if url.lower().endswith(".png") else ".jpg"))
        target.write_bytes(data)
        book["cover_url"] = url
        book["cover_etag"], book["cover_modified"] = etag, modified
        return target

    # Every candidate was unreachable or not a cover. Leaving the URL in place
    # would make the book look finished and stop it from ever being retried.
    book["cover_url"] = ""
    book["cover_rejected"] = candidates[:3]
    return None


def refresh_cover(book):
    """Re-download a cover only if the server says it changed. Returns True on
    a new picture, False when it was already current."""
    url = book.get("cover_url") or ""
    if not url or url.startswith("file://") or book.get("cover_manual"):
        return False
    try:
        data, etag, modified = http_bytes(url, etag=book.get("cover_etag", ""),
                                          modified=book.get("cover_modified", ""))
    except Exception:
        return False
    if data is None:                       # 304: nothing to do, and nothing downloaded
        return False
    if not usable_cover(data):
        return False
    for stale in COVER_DIR.glob(book["id"] + ".*"):
        stale.unlink(missing_ok=True)
    target = COVER_DIR / (book["id"] + (".png" if url.lower().endswith(".png") else ".jpg"))
    target.write_bytes(data)
    book["cover_etag"], book["cover_modified"] = etag, modified
    return True


# ── the store ───────────────────────────────────────────────────────────────

class Profile:
    """One reader's shelf: a name, an optional FantLab id, and their books."""

    def __init__(self, path, data):
        self.path = path
        self.data = data
        self._snapshot()

    def _mtime(self):
        return self.path.stat().st_mtime_ns if self.path.exists() else 0

    def _snapshot(self):
        """Remember the file as it was, so a merge can tell our edits from theirs."""
        self._stamp = self._mtime()
        self._base = {b.get("id"): dict(b) for b in self.data.get("books", [])}

    @property
    def name(self):
        return self.data.get("name", "Без имени")

    @property
    def books(self):
        return self.data.setdefault("books", [])

    @classmethod
    def create(cls, name, fantlab_id=""):
        PROFILE_DIR.mkdir(parents=True, exist_ok=True)
        slug = slugify(name)
        path = PROFILE_DIR / ("%s.json" % slug)
        n = 2
        while path.exists():
            path = PROFILE_DIR / ("%s-%d.json" % (slug, n))
            n += 1
        profile = cls(path, {"name": name, "fantlab_user_id": fantlab_id,
                             "taste_note": "", "books": [], "runs": []})
        profile.save()
        return profile

    @classmethod
    def load(cls, path):
        path = Path(path)
        return cls(path, json.loads(path.read_text("utf-8")))

    @classmethod
    def all(cls):
        PROFILE_DIR.mkdir(parents=True, exist_ok=True)
        return sorted(PROFILE_DIR.glob("*.json"))

    def save(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        if self._mtime() != self._stamp:
            # Someone edited the file while this window had it open — another
            # instance, or a hand edit. Writing our copy wholesale would silently
            # revert their work, so merge onto theirs instead: our books win where
            # we know the id, whatever we deleted stays deleted, and anything they
            # added that we never saw is kept.
            try:
                theirs = json.loads(self.path.read_text("utf-8"))
            except Exception:
                theirs = None
            if theirs:
                mine = {b.get("id"): b for b in self.books}
                merged = []
                for book in theirs.get("books", []):
                    ours = mine.pop(book.get("id"), None)
                    if ours is None:
                        # They added it, or we deleted it. Keeping it is only
                        # right in the first case, which is the one where we
                        # never saw the id.
                        if book.get("id") not in self._base:
                            merged.append(book)
                        continue
                    # Both hold this book: keep theirs and lay our own edits on
                    # top, field by field, so a rating set in another window is
                    # not rolled back by a status set in this one.
                    was = self._base.get(book.get("id"), {})
                    changed = {k: v for k, v in ours.items() if v != was.get(k)}
                    merged.append(dict(book, **changed))
                merged += [b for b in self.books if b.get("id") in mine]
                theirs.update({k: v for k, v in self.data.items() if k != "books"})
                theirs["books"] = merged
                self.data = theirs

        tmp = self.path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(self.data, ensure_ascii=False, indent=2), "utf-8")
        tmp.replace(self.path)
        self._snapshot()

    def by_status(self, status):
        return [b for b in self.books if b.get("status") == status]

    def rated(self):
        return [b for b in self.books if b.get("my_rating") or b.get("impression")]

    def knows(self, title, author):
        key = (norm(title), surname(author))
        return any((norm(b.get("title")), surname(b.get("author"))) == key for b in self.books)

    def add(self, book):
        book.setdefault("id", uuid.uuid4().hex[:12])
        book.setdefault("added", time.strftime("%Y-%m-%d"))
        book.setdefault("status", "recommended")
        book.setdefault("my_rating", None)
        book.setdefault("impression", "")
        self.books.append(book)
        return book


def sync_fantlab_marks(profile, user_id, progress=lambda text: None):
    """Cheapest possible catch-up: the marks list says everything the reader has
    rated, so one or two requests find both new books and changed marks however
    large the shelf is. Returns (added, changed)."""
    added = changed = 0
    known = {b.get("fantlab_work_id"): b for b in profile.books if b.get("fantlab_work_id")}
    for page in range(1, 40):
        try:
            items = http_json("https://api.fantlab.ru/user/%s/marks?page=%d"
                              % (user_id, page)).get("items") or []
        except Exception as exc:
            progress("оценки не пришли (%s)" % exc)
            break
        if not items:
            break
        for item in items:
            book = known.get(item.get("work_id"))
            if book is None:
                added += 1
            elif book.get("my_rating") != item.get("mark"):
                book["my_rating"] = item.get("mark")
                book["rated"] = (item.get("mark_date") or "")[:10]
                changed += 1
        time.sleep(0.3)
    if added:
        import_fantlab_marks(profile, user_id, progress)   # it knows how to shape them
    profile.save()
    return added, changed


def import_fantlab_marks(profile, user_id, progress=lambda text: None):
    """Pull a FantLab user's marks in as already-read books with their score."""
    added = 0
    for page in range(1, 40):
        progress("Страница %d…" % page)
        url = "https://api.fantlab.ru/user/%s/marks?page=%d" % (user_id, page)
        try:
            items = http_json(url).get("items") or []
        except Exception as exc:
            # Keep whatever already arrived: a timeout on page four should not
            # throw away the three hundred marks from pages one to three.
            progress("страница %d не открылась (%s), остановился здесь" % (page, exc))
            break
        if not items:
            break
        for it in items:
            title, author = it.get("work_name") or "", it.get("work_author") or ""
            if not title or profile.knows(title, author):
                continue
            image = it.get("work_image") or ""
            profile.add({
                "title": title,
                "author": author,
                "lang": "ru",
                "why": "Оценка перенесена из профиля FantLab",
                "status": "read",
                "my_rating": it.get("mark"),
                "impression": "",
                "verified": True,
                "source": "fantlab",
                "source_url": "https://fantlab.ru/work%s" % it.get("work_id"),
                "fantlab_work_id": it.get("work_id"),
                "kind": it.get("work_type") or "",
                "year": it.get("work_year"),
                "annotation": "",
                "public_rating": None,
                "public_votes": None,
                "cover_url": ("https://fantlab.ru" + image) if image.startswith("/") else image,
                "added": (it.get("mark_date") or "")[:10],
            })
            added += 1
        profile.save()
        time.sleep(0.3)
    return added


def import_legacy_log(profile):
    """Seed the shelf from recommendations-log.md, if a past session wrote one."""
    if not LEGACY_LOG.exists():
        return 0
    added = 0
    for line in LEGACY_LOG.read_text("utf-8").splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")] if line.startswith("|") else []
        if len(cells) < 5 or cells[0].startswith(("Дата", "---")) or not cells[0][:4].isdigit():
            continue
        date, title, author, why, status = cells[0], cells[1], cells[2], cells[3], cells[4]
        if not title or profile.knows(title, author):
            continue
        dropped = ("не советую" in status.lower() or "отозвано" in status.lower()
                   or "не подходит" in status.lower())
        profile.add({"title": title, "author": author, "lang": "en" if title.isascii() else "ru",
                     "why": why, "status": "skipped" if dropped else "recommended",
                     "verified": False, "source": "", "source_url": "", "kind": "", "year": None,
                     "annotation": "", "public_rating": None, "public_votes": None,
                     "cover_url": "", "added": date,
                     "note": status if dropped else ""})
        added += 1
    profile.save()
    return added


# ── asking Claude ───────────────────────────────────────────────────────────

SYSTEM_PROMPT = (
    "Ты — библиотекарь, который подбирает книги под вкус конкретного читателя.\n"
    "Отвечай ТОЛЬКО JSON-массивом, без пояснений и без markdown-ограждений.\n"
    'Элемент массива: {"title": str, "author": str, "lang": "ru" или "en", "why": str}.\n'
    "title — название цикла или первой книги ровно так, как оно издано; "
    "author — как его принято писать на языке оригинала; "
    "why — одно-два предложения о том, чем книга подходит именно этому читателю.\n"
    "Не выдумывай названий: если не уверен, что книга существует, не включай её."
)


def build_prompt(profile, ask, count):
    liked = sorted((b for b in profile.books if (b.get("my_rating") or 0) >= 9),
                   key=lambda b: -(b.get("my_rating") or 0))[:25]
    disliked = [b for b in profile.books if b.get("my_rating") and b["my_rating"] <= 6][:15]
    impressions = [b for b in profile.books if b.get("impression")][:10]
    known = [b.get("title", "") for b in profile.books][:120]

    lines = ["Подбери %d книг для читателя." % count]
    if profile.data.get("taste_note"):
        lines += ["", "О читателе: " + profile.data["taste_note"]]
    if liked:
        lines += ["", "Ставил высокие оценки:"] + \
                 ["- %s — %s (%s)" % (b.get("author", ""), b.get("title", ""), b.get("my_rating")) for b in liked]
    if disliked:
        lines += ["", "Оценил низко (такое не предлагать):"] + \
                 ["- %s — %s (%s)" % (b.get("author", ""), b.get("title", ""), b.get("my_rating")) for b in disliked]
    if impressions:
        lines += ["", "Его впечатления своими словами:"] + \
                 ["- %s: %s" % (b.get("title", ""), b["impression"][:300]) for b in impressions]
    if known:
        lines += ["", "Уже известно ему, не повторять: " + "; ".join(t for t in known if t)]
    if ask.strip():
        lines += ["", "Отдельное пожелание на эту подборку: " + ask.strip()]
    lines += ["", "Верни ровно %d рекомендаций." % count]
    return "\n".join(lines)


class ClaudeRun:
    """One `claude -p` call, running off the UI thread and cancellable."""

    def __init__(self, prompt, model, web):
        self.cmd = [
            "claude", "-p", prompt,
            "--output-format", "json",
            "--model", model,
            "--system-prompt", SYSTEM_PROMPT,
            "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
            "--disable-slash-commands",
            "--setting-sources", "",
            "--no-session-persistence",
        ]
        if web:
            self.cmd += ["--allowedTools", "WebSearch", "WebFetch"]
        else:
            self.cmd += ["--disallowedTools", "WebSearch", "WebFetch", "Bash", "Edit", "Write"]
        self.proc = None
        self.cancelled = False

    def cancel(self):
        self.cancelled = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()

    def run(self):
        """Returns (books, error_text)."""
        try:
            self.proc = subprocess.Popen(self.cmd, stdout=subprocess.PIPE,
                                         stderr=subprocess.PIPE, text=True)
            out, err = self.proc.communicate(timeout=900)
        except FileNotFoundError:
            return [], "CLI `claude` не найден в PATH."
        except subprocess.TimeoutExpired:
            self.cancel()
            return [], "Claude не ответил за 15 минут."
        if self.cancelled:
            return [], ""

        try:
            envelope = json.loads(out)
        except Exception:
            return [], (err or out or "Claude вернул не-JSON").strip()[:400]
        if envelope.get("is_error") or envelope.get("subtype") != "success":
            return [], str(envelope.get("result") or envelope.get("subtype") or "ошибка")[:400]

        payload = envelope.get("result") or ""
        match = re.search(r"\[.*\]", payload, re.S)
        if not match:
            return [], "В ответе нет JSON-массива: " + payload.strip()[:200]
        try:
            items = json.loads(match.group(0))
        except Exception as exc:
            return [], "Не разобрал JSON: %s" % exc

        books = []
        for it in items:
            if isinstance(it, dict) and it.get("title"):
                books.append({"title": str(it["title"]).strip(),
                              "author": str(it.get("author") or "").strip(),
                              "lang": "en" if it.get("lang") == "en" else "ru",
                              "why": str(it.get("why") or "").strip()})
        return books, ""


