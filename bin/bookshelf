    # refresh ----------------------------------------------------------------

    def refresh(self):
        books = self.profile.books
        rated = self.profile.rated()
        self.summary.set_text("%d книг · %d оценено · %d в подборке"
                              % (len(books), len(rated), len(self.profile.by_status("recommended"))))
        self.who.set_text(self.profile.name.upper())

        wanted = ["recommended", "reading", "skipped", None][self.shelf_filter.get_selected()]
        shelf = [b for b in books if wanted is None or b.get("status") == wanted]
        shelf.sort(key=lambda b: (not b.get("verified"), b.get("added") or ""), reverse=False)
        self.shelf.fill(self, shelf, self,
                        "Пусто. Загляни во вкладку «Подбор» и нажми «Новые рекомендации».")

        query = norm(self.ratings_search.get_text())
        listing = [b for b in rated
                   if not query or query in norm(b.get("title")) or query in norm(b.get("author"))]
        sort = self.ratings_sort.get_selected()
        if sort == 0:
            listing.sort(key=lambda b: -(b.get("my_rating") or 0))
        elif sort == 1:
            listing.sort(key=lambda b: (b.get("my_rating") or 99))
        elif sort == 2:
            listing.sort(key=lambda b: norm(b.get("author")))
        else:
            listing.sort(key=lambda b: (b.get("rated") or b.get("added") or ""), reverse=True)
        self.ratings.fill(self, listing, self,
                          "Оценок пока нет. Открой книгу с полки и поставь оценку.")

        self._refresh_profiles()

    def _refresh_profiles(self):
        self.profile_paths = Profile.all()
        names = []
        for path in self.profile_paths:
            try:
                names.append(json.loads(path.read_text("utf-8")).get("name", path.stem))
            except Exception:
                names.append(path.stem)
        model = Gtk.StringList.new(names or ["—"])
        self.profile_list.handler_block_by_func(self._profile_chosen)
        self.profile_list.set_model(model)
        if self.profile.path in self.profile_paths:
            self.profile_list.set_selected(self.profile_paths.index(self.profile.path))
        self.profile_list.handler_unblock_by_func(self._profile_chosen)

        runs = self.profile.data.get("runs", [])
        marks = [b["my_rating"] for b in self.profile.books if b.get("my_rating")]
        lines = ["Файл профиля: %s" % self.profile.path,
                 "Книг: %d · оценок: %d · средняя: %s"
                 % (len(self.profile.books), len(marks),
                    ("%.2f" % (sum(marks) / len(marks))) if marks else "—"),
                 "Подборок заказано: %d" % len(runs)]
        for run in runs[-6:][::-1]:
            lines.append("  %s · %s · %d книг%s"
                         % (run.get("ts", ""), run.get("model", ""), run.get("count", 0),
                            (" · «%s»" % run["ask"][:60]) if run.get("ask") else ""))
        self.profile_stats.set_text("\n".join(lines))

    def save_and_refresh(self):
        self.profile.save()
        self.refresh()

    # profile actions --------------------------------------------------------

    def _profile_chosen(self, dropdown, _param):
        index = dropdown.get_selected()
        if 0 <= index < len(self.profile_paths) and self.profile_paths[index] != self.profile.path:
            self.switch_profile(self.profile_paths[index])

    def _save_profile(self):
        buf = self.taste.get_buffer()
        self.profile.data["taste_note"] = buf.get_text(buf.get_start_iter(),
                                                       buf.get_end_iter(), False).strip()
        self.profile.data["fantlab_user_id"] = self.fantlab_id.get_text().strip()
        self.profile.data["google_books_key"] = self.google_key.get_text().strip()
        self.save_and_refresh()

    def _create_profile(self):
        name = self.new_name.get_text().strip()
        if not name:
            return
        profile = Profile.create(name, self.new_fantlab.get_text().strip())
        self.new_name.set_text("")
        self.new_fantlab.set_text("")
        self.switch_profile(profile.path)

    def _delete_profile(self):
        if len(Profile.all()) < 2:
            return
        doomed = self.profile.path
        remaining = [p for p in Profile.all() if p != doomed]
        doomed.unlink(missing_ok=True)
        self.switch_profile(remaining[0])

    def _import_marks(self):
        user_id = self.fantlab_id.get_text().strip()
        if not user_id:
            return
        self.profile.data["fantlab_user_id"] = user_id
        self.profile.save()
        self._log("FantLab: тяну оценки пользователя %s…" % user_id)
        self.busy("FantLab: оценки")

        def work():
            def note(text):
                GLib.idle_add(self._log, "FantLab: " + text)
                GLib.idle_add(self.busy, "FantLab: " + text)

            try:
                added = import_fantlab_marks(self.profile, user_id, note)
                GLib.idle_add(self._log, "FantLab: добавлено книг — %d" % added)
            except Exception as exc:
                GLib.idle_add(self._log, "FantLab: не вышло — %s" % exc)
            GLib.idle_add(self.busy)
            GLib.idle_add(self.refresh)

        threading.Thread(target=work, daemon=True).start()

    # enrichment -------------------------------------------------------------

    def refresh_plan(self):
        """What this launch should look at: everything still missing a card, and
        a slice of what simply has not been checked in a while."""
        now = time.time()

        def hours_since(book):
            try:
                return (now - time.mktime(time.strptime(book["checked_at"], "%Y-%m-%d %H:%M"))) / 3600
            except Exception:
                return 1e9                                  # never checked

        missing, stale = [], []
        for book in self.profile.books:
            if book.get("status") == "skipped":
                continue
            incomplete = (not book.get("verified") or not book.get("cover_url")
                          or not book.get("annotation"))
            if incomplete:
                if hours_since(book) >= RETRY_AFTER_HOURS:
                    missing.append(book)
            elif hours_since(book) >= STALE_AFTER_DAYS * 24:
                stale.append(book)
        stale.sort(key=lambda b: b.get("checked_at") or "")
        return missing, stale[:STALE_PER_LAUNCH]

    def _enrich_one(self, book):
        """Everything one book still needs, from whichever catalogue has it."""
        key = self.profile.data.get("google_books_key", "")
        if book.get("verified") and book.get("fantlab_work_id"):
            for field, value in fantlab_fill(book["fantlab_work_id"],
                                             book.get("author", "")).items():
                if value and not book.get(field):
                    book[field] = value
        if not book.get("verified") or not book.get("cover_url") or not book.get("annotation"):
            facts = resolve(book.get("title", ""), book.get("author", ""),
                            book.get("lang", "ru"), key)
            if book.get("verified"):
                # Identity is already settled; take only what is still blank.
                for field in ("cover_url", "cover_candidates", "annotation", "annotation_from"):
                    book[field] = book.get(field) or facts.get(field)
            else:
                book.update(catalogued(book, facts))
        book["enrich_tried"] = True
        book["checked_at"] = time.strftime("%Y-%m-%d %H:%M")
        cover_path(book)
        if not book.get("cover_url"):
            # Whether a picture is usable is only known once it is downloaded,
            # so this is the place to ask what else the author has: an omnibus
            # filed with a reader's photograph leaves the book confirmed and
            # coverless, and the window can then offer the separate volumes.
            book["neighbours"] = openlibrary_neighbours(book.get("title", ""),
                                                        book.get("author", ""))
        return book

    def _refresh_on_launch(self):
        """Catch up cheaply at startup: pull new marks, fill what is missing,
        then revalidate a few old entries with conditional requests that
        usually download nothing at all."""
        missing, stale = self.refresh_plan()
        user_id = self.profile.data.get("fantlab_user_id", "")
        if not missing and not stale and not user_id:
            return False
        total = len(missing) + len(stale)
        self._log("Обновление: %d без карточки, %d на проверку" % (len(missing), len(stale)))
        self.busy("проверяю изменения", 0, total)

        def work():
            if user_id:
                GLib.idle_add(self.busy, "FantLab: новые оценки", 0, total)
                added, changed = sync_fantlab_marks(self.profile, user_id)
                if added or changed:
                    GLib.idle_add(self._log, "FantLab: новых книг %d, оценок изменилось %d"
                                  % (added, changed))
                    GLib.idle_add(self.save_and_refresh)

            done = 0
            for book in missing:
                GLib.idle_add(self.busy, book.get("title", "")[:40], done, total)
                self._enrich_one(book)
                done += 1
                if done % 10 == 0:
                    GLib.idle_add(self.save_and_refresh)

            fresh = 0
            for book in stale:
                GLib.idle_add(self.busy, book.get("title", "")[:40], done, total)
                if refresh_cover(book):
                    fresh += 1
                book["checked_at"] = time.strftime("%Y-%m-%d %H:%M")
                done += 1
            GLib.idle_add(self._log, "Обновление закончено, обложек обновилось: %d" % fresh)
            GLib.idle_add(self.save_and_refresh)
            GLib.idle_add(self.busy)

        threading.Thread(target=work, daemon=True).start()
        return False

    def enrich_pending(self, only_untried):
        """Books still missing something — a card, a cover, a blurb.

        `only_untried` is for the automatic pass at startup, where a title that
        exists nowhere should not be re-queried on every launch. Pressing the
        button is the opposite case: the reader is explicitly asking for
        another go, so every gap is retried, whatever happened last time.
        """
        out = []
        for book in self.profile.books:
            if book.get("status") == "skipped":
                continue
            if book.get("verified") and book.get("cover_url") and book.get("annotation"):
                continue
            if only_untried and book.get("enrich_tried"):
                continue
            out.append(book)
        return out

    def _enrich_one(self, book):
        """Everything one book still needs, from whichever catalogue has it."""
        key = self.profile.data.get("google_books_key", "")
        if book.get("verified") and book.get("fantlab_work_id"):
            for field, value in fantlab_fill(book["fantlab_work_id"],
                                             book.get("author", "")).items():
                if value and not book.get(field):
                    book[field] = value
        if not book.get("verified") or not book.get("cover_url") or not book.get("annotation"):
            facts = resolve(book.get("title", ""), book.get("author", ""),
                            book.get("lang", "ru"), key)
            if book.get("verified"):
                # Identity is already settled; take only what is still blank.
                for field in ("cover_url", "cover_candidates", "annotation", "annotation_from"):
                    book[field] = book.get(field) or facts.get(field)
            else:
                book.update(catalogued(book, facts))
        book["enrich_tried"] = True
        book["checked_at"] = time.strftime("%Y-%m-%d %H:%M")
        cover_path(book)
        if not book.get("cover_url"):
            # Whether a picture is usable is only known once it is downloaded,
            # so this is the place to ask what else the author has: an omnibus
            # filed with a reader's photograph leaves the book confirmed and
            # coverless, and the window can then offer the separate volumes.
            book["neighbours"] = openlibrary_neighbours(book.get("title", ""),
                                                        book.get("author", ""))
        return book

    def _refresh_on_launch(self):
        """Catch up cheaply at startup: pull new marks, fill what is missing,
        then revalidate a few old entries with conditional requests that
        usually download nothing at all."""
        missing, stale = self.refresh_plan()
