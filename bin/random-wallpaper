#!/usr/bin/env python3
"""A reel of random wallpapers: keep the ones you want, drop the rest.

Replaces iNiR's random_konachan_wall.sh, which downloaded straight over
~/Pictures/Wallpapers/random_wallpaper.jpg — one slot, silently overwritten on
every run, so keeping an image meant racing to copy it out by hand.

Downloads land in a cache directory and are only ever moved into SAVE_DIR when
you press Save, under a name that does not exist yet. Delete unlinks the cached
file and touches nothing else, so no wallpaper you already kept can be damaged
by anything this app does.

The window never closes on Save or Delete — it advances to the next frame in
the reel, which is prefetched in the background so the wait is invisible.
"""
import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")

import json
import os
import random
import shutil
import subprocess
import tempfile
import threading
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

from gi.repository import GdkPixbuf, Gdk, GLib, Gtk

# Hardcoded on purpose: one known place, independent of XDG_PICTURES_DIR, so a
# keybind and a terminal run always agree on where saved wallpapers live.
SAVE_DIR = Path.home() / "random_wallpaper"

CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "random-wallpaper"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "random-wallpaper"
CONFIG_FILE = CONFIG_DIR / "config.json"

# Konachan rejects the default urllib agent.
USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"
)

TIMEOUT = 30
REEL_AHEAD = 3          # frames kept downloaded ahead of the current one
IMAGE_EXTS = (".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp")

ORIENTATIONS = [
    ("Any", "any"),
    ("Landscape", "landscape"),
    ("Portrait", "portrait"),
]

RATINGS = [
    ("Safe", "safe"),
    ("Sketchy", "sketchy"),
    ("18+", "nsfw"),
]

MINIMUMS = [
    ("Any size", ""),
    ("1920×1080", "1920x1080"),
    ("2560×1440", "2560x1440"),
    ("3840×2160", "3840x2160"),
]

DEFAULTS = {
    "source": "konachan",
    "orientation": "any",
    "rating": "safe",
    "minimum": "1920x1080",
    "wallhaven_general": True,
    "wallhaven_anime": True,
    "wallhaven_people": False,
    "wallhaven_apikey": "",
    "set_on_save": True,
}


class FetchError(Exception):
    """Anything that means "no usable image this time" — always shown to the
    user verbatim, never swallowed."""


# ── preferences ─────────────────────────────────────────────────────────────
def load_prefs():
    prefs = dict(DEFAULTS)
    try:
        prefs.update(json.loads(CONFIG_FILE.read_text()))
    except (OSError, ValueError):
        pass
    return prefs


def save_prefs(prefs):
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(json.dumps(prefs, indent=2, sort_keys=True) + "\n")
        CONFIG_FILE.chmod(0o600)   # it can hold a wallhaven API key
    except OSError:
        pass


def wallhaven_key(prefs):
    """Environment first, so the key can live in fish's gitignored secrets.fish
    rather than in a config file."""
    return os.environ.get("WALLHAVEN_API_KEY", "").strip() or prefs["wallhaven_apikey"].strip()


# ── sources ─────────────────────────────────────────────────────────────────
def _get(url):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return resp.read()


def _get_json(url):
    return json.loads(_get(url))


def _min_size(prefs):
    if not prefs["minimum"]:
        return 0, 0
    w, _, h = prefs["minimum"].partition("x")
    return int(w), int(h)


def _fits(prefs, width, height):
    if not (width and height):
        return True          # unknown dimensions: let it through, judge by eye
    min_w, min_h = _min_size(prefs)
    if width < min_w or height < min_h:
        return False
    if prefs["orientation"] == "landscape" and width < height:
        return False
    if prefs["orientation"] == "portrait" and height < width:
        return False
    return True


def pick_konachan(prefs):
    """konachan.net serves safe posts only; anything else needs .com. The API
    has no random endpoint, so we jump to a random page and filter locally —
    hence limit=40 rather than 1."""
    host = "konachan.net" if prefs["rating"] == "safe" else "konachan.com"
    tags = {
        "safe": "rating:safe",
        "sketchy": "rating:questionable",
        "nsfw": "rating:explicit",
    }[prefs["rating"]]

    page = random.randint(1, 200)
    url = (
        f"https://{host}/post.json?tags={urllib.parse.quote(tags)}"
        f"&limit=40&page={page}"
    )
    posts = _get_json(url)
    if not posts:
        raise FetchError(f"konachan has no {tags} posts on page {page} — try again")

    usable = [p for p in posts if p.get("file_url")
              and _fits(prefs, p.get("width"), p.get("height"))]
    if not usable:
        raise FetchError(
            f"none of the {len(posts)} posts on page {page} match the size and "
            "orientation filters"
        )

    post = random.choice(usable)
    file_url = post["file_url"]
    if file_url.startswith("//"):
        file_url = "https:" + file_url
    return {
        "url": file_url,
        "name": f"konachan-{post.get('id', 'x')}",
        "width": post.get("width"),
        "height": post.get("height"),
        "credit": post.get("author") or host,
        "source": "Konachan",
    }


def pick_wallhaven(prefs):
    categories = "".join(
        "1" if prefs[k] else "0"
        for k in ("wallhaven_general", "wallhaven_anime", "wallhaven_people")
    )
    if categories == "000":
        raise FetchError("every wallhaven category is switched off")

    purity = {"safe": "100", "sketchy": "110", "nsfw": "111"}[prefs["rating"]]
    key = wallhaven_key(prefs)
    if prefs["rating"] == "nsfw" and not key:
        raise FetchError(
            "wallhaven only serves 18+ results to an account. Put your API key "
            "in Settings, or set WALLHAVEN_API_KEY."
        )

    params = {
        "sorting": "random",
        "purity": purity,
        "categories": categories,
    }
    if prefs["minimum"]:
        params["atleast"] = prefs["minimum"]
    if prefs["orientation"] == "landscape":
        params["ratios"] = "16x9,16x10,21x9"
    elif prefs["orientation"] == "portrait":
        params["ratios"] = "9x16,10x16,9x18"
    if key:
        params["apikey"] = key

    url = "https://wallhaven.cc/api/v1/search?" + urllib.parse.urlencode(params)
    posts = _get_json(url).get("data") or []
    posts = [p for p in posts if p.get("path")]
    if not posts:
        raise FetchError("wallhaven returned nothing for these filters")

    post = random.choice(posts)
    return {
        "url": post["path"],
        "name": f"wallhaven-{post.get('id', 'x')}",
        "width": post.get("dimension_x"),
        "height": post.get("dimension_y"),
        "credit": post.get("uploader", {}).get("username") or "wallhaven.cc",
        "source": "Wallhaven",
    }


# The osu! seasonal-backgrounds endpoint the old shell script used now answers
# 403 — it went behind OAuth — so wallhaven takes its place as second source.
SOURCES = [
    ("Konachan", "konachan", pick_konachan),
    ("Wallhaven", "wallhaven", pick_wallhaven),
]


def source_index(name):
    for i, (_, key, _) in enumerate(SOURCES):
        if key == name:
            return i
    return 0


def download(prefs):
    """Runs off the main thread. Returns a frame: metadata plus a cached file."""
    meta = SOURCES[source_index(prefs["source"])][2](prefs)

    ext = Path(urllib.parse.urlparse(meta["url"]).path).suffix.lower()
    if ext not in IMAGE_EXTS:
        ext = ".jpg"

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=CACHE_DIR, prefix="pending-", suffix=ext)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(_get(meta["url"]))
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise

    meta["path"] = Path(tmp)
    meta["ext"] = ext
    meta["bytes"] = meta["path"].stat().st_size
    return meta


# ── files ───────────────────────────────────────────────────────────────────
def pictures_wallpapers():
    """Noctalia's picker and its wallpaper-random rotation scan this directory,
    not SAVE_DIR, so saved images are linked into it as well."""
    try:
        out = subprocess.run(
            ["xdg-user-dir", "PICTURES"], capture_output=True, text=True, timeout=5,
        ).stdout.strip()
    except (subprocess.SubprocessError, OSError):
        out = ""
    return Path(out or Path.home() / "Pictures") / "Wallpapers"


def prune_cache():
    """Drop downloads orphaned by a crash or a kill — they were never accepted,
    so nothing references them."""
    for stale in CACHE_DIR.glob("pending-*"):
        try:
            stale.unlink()
        except OSError:
            pass


def human_size(n):
    if n < 1024:
        return f"{n} B"
    if n < 1024 * 1024:
        return f"{n / 1024:.0f} KB"
    return f"{n / 1024 / 1024:.1f} MB"


def unique_path(directory, stem, ext):
    """A name that does not exist yet. This is what makes Save non-destructive:
    we never open an existing file for writing."""
    candidate = directory / f"{stem}{ext}"
    n = 2
    while candidate.exists():
        candidate = directory / f"{stem}-{n}{ext}"
        n += 1
    return candidate


