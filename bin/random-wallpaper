def eyebrow(text):
    label = Gtk.Label(label=text, xalign=0)
    label.add_css_class("eyebrow")
    return label


def perforations():
    """Three small blocks — the sprocket holes that say "one frame of many"."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box.set_valign(Gtk.Align.CENTER)
    for _ in range(3):
        hole = Gtk.Box()
        hole.add_css_class("perf")
        hole.set_size_request(5, 5)
        hole.set_opacity(0.5)
        box.append(hole)
    return box


class Settings(Gtk.Window):
    def __init__(self, parent, prefs, on_change):
        super().__init__(title="Wallpaper filters", transient_for=parent, modal=True)
        self.set_default_size(400, -1)
        self.prefs = prefs
        self.on_change = on_change

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        root.add_css_class("settings-root")
        root.set_margin_start(18)
        root.set_margin_end(18)
        root.set_margin_top(18)
        root.set_margin_bottom(18)
        self.set_child(root)

        grid = Gtk.Grid(row_spacing=10, column_spacing=14)
        grid.add_css_class("card")
        root.append(grid)

        self.source = self._row(grid, 0, "SOURCE", [s[0] for s in SOURCES],
                                source_index(prefs["source"]))
        self.orientation = self._row(grid, 1, "ORIENTATION",
                                     [o[0] for o in ORIENTATIONS],
                                     self._pos(ORIENTATIONS, prefs["orientation"]))
        self.minimum = self._row(grid, 2, "MINIMUM SIZE", [m[0] for m in MINIMUMS],
                                 self._pos(MINIMUMS, prefs["minimum"]))
        self.rating = self._row(grid, 3, "RATING", [r[0] for r in RATINGS],
                                self._pos(RATINGS, prefs["rating"]))

        self.rating_hint = Gtk.Label(xalign=0, wrap=True)
        self.rating_hint.add_css_class("hint")
        grid.attach(self.rating_hint, 0, 4, 2, 1)

        # ── wallhaven-only ──────────────────────────────────────────────────
        wh = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        wh.add_css_class("card")
        root.append(wh)
        wh.append(eyebrow("WALLHAVEN CATEGORIES"))

        cats = Gtk.Box(spacing=16)
        wh.append(cats)
        self.cat_general = Gtk.CheckButton(label="General", active=prefs["wallhaven_general"])
        self.cat_anime = Gtk.CheckButton(label="Anime", active=prefs["wallhaven_anime"])
        self.cat_people = Gtk.CheckButton(label="People", active=prefs["wallhaven_people"])
        for c in (self.cat_general, self.cat_anime, self.cat_people):
            c.connect("toggled", lambda *_: self.apply())
            cats.append(c)

        wh.append(eyebrow("API KEY — ONLY NEEDED FOR 18+"))
        self.apikey = Gtk.Entry(text=prefs["wallhaven_apikey"],
                                placeholder_text="wallhaven.cc/settings/account")
        self.apikey.set_visibility(False)
        self.apikey.connect("changed", lambda *_: self.apply())
        wh.append(self.apikey)

        env_key = os.environ.get("WALLHAVEN_API_KEY", "").strip()
        if env_key:
            self.apikey.set_sensitive(False)
            self.apikey.set_placeholder_text("taken from WALLHAVEN_API_KEY")

        close = Gtk.Button(label="Done")
        close.add_css_class("btn")
        close.set_halign(Gtk.Align.END)
        close.connect("clicked", lambda *_: self.close())
        root.append(close)

        self.refresh_hint()

    @staticmethod
    def _pos(table, value):
        for i, (_, key) in enumerate(table):
            if key == value:
                return i
        return 0

    def _row(self, grid, row, label, options, selected):
        grid.attach(eyebrow(label), 0, row, 1, 1)
        drop = Gtk.DropDown.new_from_strings(options)
        drop.set_selected(selected)
        drop.set_hexpand(True)
        drop.connect("notify::selected", lambda *_: self.apply())
        grid.attach(drop, 1, row, 1, 1)
        return drop

    def refresh_hint(self):
        rating = RATINGS[self.rating.get_selected()][1]
        source = SOURCES[self.source.get_selected()][1]
        if rating == "nsfw" and source == "wallhaven" and not wallhaven_key(self.prefs):
            self.rating_hint.set_text(
                "Wallhaven serves 18+ results only with an API key — add one below."
            )
        elif rating != "safe" and source == "konachan":
            self.rating_hint.set_text(
                "Konachan switches to konachan.com for anything above Safe."
            )
        else:
            self.rating_hint.set_text("")

    def apply(self):
        self.prefs.update({
            "source": SOURCES[self.source.get_selected()][1],
            "orientation": ORIENTATIONS[self.orientation.get_selected()][1],
            "minimum": MINIMUMS[self.minimum.get_selected()][1],
            "rating": RATINGS[self.rating.get_selected()][1],
            "wallhaven_general": self.cat_general.get_active(),
            "wallhaven_anime": self.cat_anime.get_active(),
            "wallhaven_people": self.cat_people.get_active(),
            "wallhaven_apikey": self.apikey.get_text(),
        })
        save_prefs(self.prefs)
        self.refresh_hint()
        self.on_change()


class Reel(Gtk.ApplicationWindow):
    def __init__(self, app, prefs):
        super().__init__(application=app, title="Random Wallpaper")
        self.set_default_size(1000, 760)
        self.prefs = prefs

        self.frames = []       # downloaded, undecided
        self.index = 0
        self.inflight = 0
        self.error = None

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.add_css_class("reel-root")
        self.set_child(root)

        # ── top bar ─────────────────────────────────────────────────────────
        top = Gtk.Box(spacing=12)
        top.add_css_class("topbar")
        root.append(top)

        wordmark = Gtk.Label(label="RANDOM WALLPAPER")
        wordmark.add_css_class("wordmark")
        top.append(wordmark)

        self.filter_summary = Gtk.Label(xalign=0)
        self.filter_summary.add_css_class("mono")
        self.filter_summary.set_hexpand(True)
        top.append(self.filter_summary)

        self.position = Gtk.Label()
        self.position.add_css_class("mono")
        top.append(self.position)

        settings_btn = Gtk.Button(label="Filters")
        settings_btn.add_css_class("btn")
        settings_btn.add_css_class("btn-icon")
        settings_btn.connect("clicked", lambda *_: self.open_settings())
        top.append(settings_btn)

        # ── stage ───────────────────────────────────────────────────────────
        stage = Gtk.Box(spacing=10)
        stage.add_css_class("stage")
        stage.set_vexpand(True)
        root.append(stage)

        stage.append(perforations())

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               transition_duration=120)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        stage.append(self.stack)

        self.picture = Gtk.Picture()
        self.picture.set_content_fit(Gtk.ContentFit.CONTAIN)
        self.picture.set_can_shrink(True)
        self.picture.set_margin_top(10)
        self.picture.set_margin_bottom(10)
        self.stack.add_named(self.picture, "image")

        self.message = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        self.message.add_css_class("placeholder")
        self.message.set_margin_start(40)
        self.message.set_margin_end(40)
        self.stack.add_named(self.message, "message")

        stage.append(perforations())

        # ── bottom bar ──────────────────────────────────────────────────────
        bottom = Gtk.Box(spacing=12)
        bottom.add_css_class("bottombar")
        root.append(bottom)

        meta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        meta.set_hexpand(True)
        meta.set_valign(Gtk.Align.CENTER)
        bottom.append(meta)

        self.frame_name = Gtk.Label(xalign=0, ellipsize=3)
        self.frame_name.add_css_class("frame-name")
        meta.append(self.frame_name)

        self.frame_meta = Gtk.Label(xalign=0, ellipsize=3)
        self.frame_meta.add_css_class("mono")
        meta.append(self.frame_meta)

        self.prev_btn = self._button(bottom, "‹", "Previous frame (Left)",
                                     lambda: self.go(self.index - 1), icon=True)
        self.next_btn = self._button(bottom, "›", "Next frame (Right)",
                                     lambda: self.go(self.index + 1), icon=True)
        self.delete_btn = self._button(bottom, "Delete", "Throw this one away (D)",
                                       self.delete, css="btn-danger")
        self.save_btn = self._button(bottom, "Save", f"Keep it in {SAVE_DIR} (S)",
                                     self.save, css="btn-accent")

        # ── reel strip ──────────────────────────────────────────────────────
        self.strip = Gtk.Box(spacing=8)
        self.strip.add_css_class("reel")
        strip_scroll = Gtk.ScrolledWindow()
        strip_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        strip_scroll.set_child(self.strip)
        strip_scroll.set_size_request(-1, 78)
        root.append(strip_scroll)

        # ── toast ───────────────────────────────────────────────────────────
        self.toast = Gtk.Label()
        self.toast.add_css_class("toast")
        self.toast.set_halign(Gtk.Align.CENTER)
        self.toast.set_visible(False)
        self.toast.set_margin_bottom(10)
        root.append(self.toast)
        self.toast_timer = None

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        # Nothing is saved until Save is pressed, so closing discards whatever
        # is still pending — otherwise the cache fills with abandoned downloads.
        self.connect("close-request", self.on_close)

        self.refresh_summary()
        self.top_up()
        self.sync()

    def _button(self, parent, label, tooltip, handler, css=None, icon=False):
        btn = Gtk.Button(label=label)
        btn.add_css_class("btn")
        if icon:
            btn.add_css_class("btn-icon")
        if css:
            btn.add_css_class(css)
        btn.set_tooltip_text(tooltip)
        btn.connect("clicked", lambda *_: handler())
        parent.append(btn)
        return btn

    # ── the reel ────────────────────────────────────────────────────────────
    def top_up(self):
        """Keep REEL_AHEAD frames downloaded past the current one."""
        want = self.index + 1 + REEL_AHEAD - len(self.frames) - self.inflight
        for _ in range(max(0, want)):
            self.inflight += 1
            prefs = dict(self.prefs)

            def work(prefs=prefs):
                try:
                    frame = download(prefs)
                except (urllib.error.URLError, OSError, ValueError, FetchError) as exc:
                    GLib.idle_add(self.arrived, None, str(exc))
                else:
                    GLib.idle_add(self.arrived, frame, None)

            threading.Thread(target=work, daemon=True).start()

    def arrived(self, frame, error):
        self.inflight -= 1
        if frame:
            self.frames.append(frame)
            self.error = None
        else:
            self.error = error
        self.sync()
        return False

    def current(self):
        return self.frames[self.index] if self.index < len(self.frames) else None

    def go(self, index):
        if 0 <= index < len(self.frames):
            self.index = index
            self.top_up()
            self.sync()

    def advance(self):
        """Called after a frame leaves the reel. The list shrank under us, so
        the same index is already the next frame — unless we were at the end."""
        if self.index >= len(self.frames):
            self.index = max(0, len(self.frames) - 1)
        self.top_up()
        self.sync()

    # ── actions ─────────────────────────────────────────────────────────────
    def save(self):
        frame = self.current()
        if not frame:
            return
        SAVE_DIR.mkdir(parents=True, exist_ok=True)
        dest = unique_path(SAVE_DIR, frame["name"], frame["ext"])

        # move, not copy: the cache file is the only copy and it is going away
        shutil.move(str(frame["path"]), dest)
        self.frames.pop(self.index)

        self.link_into_pictures(dest)
        if self.prefs["set_on_save"]:
            self.apply_wallpaper(dest)
        self.show_toast(f"Saved  {dest}")
        self.advance()

    def delete(self):
        frame = self.current()
        if not frame:
            return
        frame["path"].unlink(missing_ok=True)
        self.frames.pop(self.index)
        self.show_toast(f"Dropped  {frame['name']}")
        self.advance()

    def link_into_pictures(self, saved):
        """Hardlink the saved file into ~/Pictures/Wallpapers so it shows up in
        Noctalia's picker. Hardlink, not copy: same filesystem, no extra bytes.
        Uniquified like the save itself, so it cannot overwrite anything."""
        try:
            directory = pictures_wallpapers()
            directory.mkdir(parents=True, exist_ok=True)
            link = unique_path(directory, saved.stem, saved.suffix)
            try:
                os.link(saved, link)
            except OSError:
                link.symlink_to(saved)   # different filesystem
        except OSError as exc:
            self.show_toast(f"Saved, but not linked into Pictures: {exc}")

    def apply_wallpaper(self, path):
        try:
            subprocess.run(
                ["noctalia", "msg", "wallpaper-set", str(path)],
                check=True, capture_output=True, timeout=10,
            )
        except (subprocess.SubprocessError, OSError) as exc:
            # Saving already succeeded; a failed apply must not read as a
            # failed save.
            self.show_toast(f"Saved, but could not set it: {exc}")

    def open_settings(self):
        def changed():
            self.refresh_summary()
            self.top_up()
        Settings(self, self.prefs, changed).present()

    # ── rendering ───────────────────────────────────────────────────────────
    def refresh_summary(self):
        bits = [SOURCES[source_index(self.prefs["source"])][0].upper()]
        orientation = dict((v, k) for k, v in ORIENTATIONS)[self.prefs["orientation"]]
        bits.append(orientation.upper())
        bits.append(dict((v, k) for k, v in MINIMUMS)[self.prefs["minimum"]].upper())
        bits.append(dict((v, k) for k, v in RATINGS)[self.prefs["rating"]].upper())
        self.filter_summary.set_text("  ·  ".join(bits))

    def sync(self):
        frame = self.current()
        pending = self.inflight > 0

        self.save_btn.set_sensitive(frame is not None)
        self.delete_btn.set_sensitive(frame is not None)
        self.prev_btn.set_sensitive(self.index > 0)
        self.next_btn.set_sensitive(self.index + 1 < len(self.frames))

        if frame:
            self.position.set_text(f"{self.index + 1}/{len(self.frames)}")
            self.picture.set_filename(str(frame["path"]))
            self.stack.set_visible_child_name("image")
            self.frame_name.set_text(frame["name"])

            w, h = frame.get("width"), frame.get("height")
            if not (w and h):
                paintable = self.picture.get_paintable()
                if paintable:
                    w = paintable.get_intrinsic_width() or None
                    h = paintable.get_intrinsic_height() or None
            bits = [frame["source"]]
            if w and h:
                bits.append(f"{w}×{h}")
            bits.append(human_size(frame["bytes"]))
            if frame.get("credit"):
                bits.append(frame["credit"])
            self.frame_meta.set_text("  ·  ".join(bits))
        else:
            self.position.set_text("")
            self.frame_name.set_text("")
            self.frame_meta.set_text("")
            self.message.set_text(
                "Loading the reel…" if pending
                else self.error or "Nothing left in the reel."
            )
            self.stack.set_visible_child_name("message")

        self.rebuild_strip()

    def rebuild_strip(self):
        while (child := self.strip.get_first_child()) is not None:
            self.strip.remove(child)

        for i, frame in enumerate(self.frames):
            button = Gtk.Button()
            button.add_css_class("reel-frame")
            if i == self.index:
                button.add_css_class("current")
            button.set_tooltip_text(frame["name"])
            button.connect("clicked", lambda _b, i=i: self.go(i))

            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    str(frame["path"]), 96, 54, True,
                )
                child = Gtk.Picture.new_for_pixbuf(pixbuf)
                child.set_content_fit(Gtk.ContentFit.COVER)
            except GLib.Error:
                child = Gtk.Label(label="?")
            child.set_size_request(96, 54)
            button.set_child(child)
            self.strip.append(button)

        if self.inflight:
            spinner = Gtk.Spinner()
            spinner.set_size_request(96, 54)
            spinner.start()
            self.strip.append(spinner)

    def show_toast(self, text):
        self.toast.set_text(text)
        self.toast.set_visible(True)
        if self.toast_timer:
            GLib.source_remove(self.toast_timer)
        self.toast_timer = GLib.timeout_add_seconds(4, self.hide_toast)

    def hide_toast(self):
        self.toast.set_visible(False)
        self.toast_timer = None
        return False

    # ── input ───────────────────────────────────────────────────────────────
    def on_key(self, _controller, keyval, _keycode, state):
        if state & Gdk.ModifierType.CONTROL_MASK:
            return False
        name = Gdk.keyval_name(keyval)
        if name in ("s", "S", "Return"):
            self.save()
        elif name in ("d", "D", "Delete", "BackSpace"):
            self.delete()
        elif name in ("Right", "n", "N", "space"):
            self.go(self.index + 1)
        elif name in ("Left", "p", "P"):
            self.go(self.index - 1)
        elif name in ("comma", "F2"):
            self.open_settings()
        elif name in ("q", "Q", "Escape"):
            self.close()
        else:
            return False
        return True

    def on_close(self, *_):
        for frame in self.frames:
            frame["path"].unlink(missing_ok=True)
        self.frames.clear()
        return False


class App(Gtk.Application):
    def __init__(self, prefs):
        super().__init__(application_id="dev.ivanc.RandomWallpaper")
        self.prefs = prefs

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        # Above PRIORITY_USER (800), not the usual APPLICATION (600): a
        # ~/.config/gtk-4.0/gtk.css — every ricing setup has one — is loaded at
        # USER and would otherwise repaint this window with the desktop theme.
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1,
        )

    def do_activate(self):
        win = self.props.active_window or Reel(self, self.prefs)
        win.present()


def main():
    import argparse

    prefs = load_prefs()
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--source", choices=[s[1] for s in SOURCES],
                        help="override the saved source for this run")
    parser.add_argument("--orientation", choices=[o[1] for o in ORIENTATIONS],
                        help="override the saved orientation for this run")
    args = parser.parse_args()

    if args.source:
        prefs["source"] = args.source
    if args.orientation:
        prefs["orientation"] = args.orientation

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    prune_cache()
    App(prefs).run([])


if __name__ == "__main__":
    main()
