#!/usr/bin/env python3
"""Disable the touchpad while the nvim window (app-id="nvim") is focused.

Runs as a niri-spawned daemon. Watches niri's event stream and takes an
exclusive EVIOCGRAB on the touchpad's evdev nodes whenever the focused window
is nvim, releasing it otherwise. Fail-open: any error or exit releases the
grab, so the touchpad can never get stuck disabled.

Access to the evdev nodes comes from /etc/udev/rules.d/71-touchpad-uaccess.rules
(a per-seat ACL); without it every open() here fails with EACCES.
"""
import fcntl
import glob
import json
import os
import signal
import subprocess
import sys

EVIOCGRAB = 0x40044590  # _IOW('E', 0x90, int)
NVIM_APP_ID = "nvim"


def log(msg):
    print(f"niri-nvim-touchpad: {msg}", file=sys.stderr, flush=True)


def hid_parent(node):
    """Physical device directory behind an evdev node (.../0018:093A:0255.0001)."""
    link = f"/sys/class/input/{os.path.basename(node)}/device"
    return os.path.dirname(os.path.dirname(os.path.realpath(link)))


def find_touchpad_nodes():
    """Every evdev node of the physical touchpad.

    One I2C-HID touchpad usually exposes several nodes ("... Touchpad" plus a
    sibling "... Mouse"); grabbing only one of them leaves the pad half-alive,
    so collect all nodes sharing the touchpad's parent HID device.
    """
    nodes = sorted(glob.glob("/dev/input/event*"))
    pads = []
    for ev in nodes:
        try:
            name = open(f"/sys/class/input/{os.path.basename(ev)}/device/name").read()
        except OSError:
            continue
        if "touchpad" in name.strip().lower():
            pads.append(ev)
    if not pads:
        return []
    parents = {hid_parent(ev) for ev in pads}
    return [ev for ev in nodes if hid_parent(ev) in parents]


class Grabber:
    def __init__(self, nodes):
        self.nodes = nodes
        self.fds = {}  # node -> fd, open only while grabbed

    def set(self, want):
        if want:
            for node in self.nodes:
                if node in self.fds:
                    continue
                try:
                    fd = os.open(node, os.O_RDONLY)
                    fcntl.ioctl(fd, EVIOCGRAB, 1)
                except OSError as e:
                    # Fail open on this node rather than kill the daemon.
                    log(f"cannot grab {node}: {e}")
                    continue
                self.fds[node] = fd
        else:
            for node, fd in list(self.fds.items()):
                try:
                    fcntl.ioctl(fd, EVIOCGRAB, 0)
                except OSError as e:
                    log(f"cannot ungrab {node}: {e}")
                finally:
                    os.close(fd)
                    del self.fds[node]

    def release(self, *_):
        try:
            self.set(False)
        finally:
            sys.exit(0)


def main():
    nodes = find_touchpad_nodes()
    if not nodes:
        sys.exit("niri-nvim-touchpad: no touchpad device found")
    log(f"watching {' '.join(nodes)}")

    grab = Grabber(nodes)
    signal.signal(signal.SIGTERM, grab.release)
    signal.signal(signal.SIGINT, grab.release)

    app_by_id = {}     # window id -> app_id
    focused_id = None

    def refocus():
        grab.set(app_by_id.get(focused_id) == NVIM_APP_ID)

    proc = subprocess.Popen(
        ["niri", "msg", "--json", "event-stream"],
        stdout=subprocess.PIPE, text=True,
    )
    try:
        for line in proc.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue

            if "WindowsChanged" in ev:
                app_by_id.clear()
                for w in ev["WindowsChanged"]["windows"]:
                    app_by_id[w["id"]] = w.get("app_id")
                    if w.get("is_focused"):
                        focused_id = w["id"]
                refocus()
            elif "WindowOpenedOrChanged" in ev:
                w = ev["WindowOpenedOrChanged"]["window"]
                app_by_id[w["id"]] = w.get("app_id")
                if w.get("is_focused"):
                    focused_id = w["id"]
                refocus()
            elif "WindowClosed" in ev:
                app_by_id.pop(ev["WindowClosed"]["id"], None)
                refocus()
            elif "WindowFocusChanged" in ev:
                focused_id = ev["WindowFocusChanged"].get("id")
                refocus()
    finally:
        grab.set(False)
        proc.terminate()


if __name__ == "__main__":
    main()
