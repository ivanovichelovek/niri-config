# Give the active seat's user (via ACL, not the input group) direct evdev access
# to the internal touchpad, so ~/.local/bin/niri-nvim-touchpad can EVIOCGRAB it
# while the nvim window is focused.
#
# Must sort between 60-input-id.rules (sets ID_INPUT_TOUCHPAD) and
# 73-seat-late.rules (consumes TAG+="uaccess"). 71- satisfies both.

SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHPAD}=="1", TAG+="uaccess"

# The same physical I2C-HID device also exposes a sibling "... Mouse" node that
# can emit pointer events on its own; grabbing only the Touchpad node would
# leave the pad half-alive. Scoped to this laptop's touchpad by name — on other
# hardware, read the name off `grep -H . /sys/class/input/event*/device/name`
# and adjust, or drop this line if the pad exposes only one node.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", ATTRS{name}=="HTIX5288:00 093A:0255*", TAG+="uaccess"
