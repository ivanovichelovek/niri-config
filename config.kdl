// ─────────────────────────────────────────────────────────────────────────────
// Niri Compositor Configuration
// ─────────────────────────────────────────────────────────────────────────────
//
// Split into modular files under config.d/ so you can edit individual sections
// without touching the rest. Niri auto-reloads on save.
//
//   10  Input, touchpad, mouse, cursor
//   20  Layout, gaps, borders, shadows, overview
//   30  Window rules (corner radius, per-app tweaks)
//   40  Environment variables (Qt, XDG, theming)
//   50  Processes spawned at login
//   60  Animations (spring physics tuning)
//   70  Key bindings (window management + Noctalia shell)
//   80  Layer rules (shell surfaces)
//   90  Personal overrides — named workspaces, per-app assignment
//
// Shell: Noctalia (https://noctalia.dev), a standalone Wayland shell.
// Only 50, 70 and 80 reference it; everything else is pure compositor config.
//
// Docs: https://niri-wm.github.io/niri/Configuration:-Introduction
// KDL format: https://kdl.dev
// ─────────────────────────────────────────────────────────────────────────────

// Ask apps to drop client-side decorations so Niri draws borders around them.
// This also fixes border/focus-ring rendering behind semitransparent windows.
// Restart apps after toggling this.
prefer-no-csd

// Don't pop the hotkey cheatsheet on every login — it stays on Mod+/.
hotkey-overlay {
    skip-at-startup
}

// Honor activation tokens even with invalid serials — lets apps like VS Code,
// Firefox, etc. steal focus when another app requests it (e.g. Nautilus open-with).
debug {
    honor-xdg-activation-with-invalid-serial
}

// Rootless X server for X11-only apps. niri starts it and exports DISPLAY into
// the session itself — do not also spawn it from 50-startup.kdl or you get two.
// Happ needs this: it bundles Qt 6.5, ignores QT_QPA_PLATFORM and always loads
// the xcb platform plugin, so without an X server it aborts with SIGABRT.
xwayland-satellite {
    path "/usr/bin/xwayland-satellite"
}

// Where native Niri screenshots land (Print key).
// Noctalia's region selector (Mod+Shift+S) uses its own configured path.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ── Modular includes ────────────────────────────────────────────────────────
include "config.d/10-input-and-cursor.kdl"
include "config.d/20-layout-and-overview.kdl"
include "config.d/30-window-rules.kdl"
include "config.d/40-environment.kdl"
include "config.d/50-startup.kdl"
include "config.d/60-animations.kdl"
include "config.d/70-binds.kdl"
include "config.d/80-layer-rules.kdl"
include "config.d/90-user-extra.kdl"
// Generated by bin/niri-pin-window (Mod+O). Must load after 30-window-rules.kdl
// so a pin overrides the global unfocused dim.
include "config.d/95-pinned.kdl"
